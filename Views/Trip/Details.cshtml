@model Public_Transport.Models.Entities.Trip
@using System.Text.Json;

@{
    ViewData["Title"] = "Chi tiết lộ trình";
    // 1. Chuyển dữ liệu các trạm sang JSON để JavaScript đọc được
    var stationsJson = JsonSerializer.Serialize(Model.Route.RouteDetails.Select(x => new
    {
        name = x.Station.StationName,
        address = x.Station.Address,
        coords = x.Station.Coordinates, // Dạng "10.123, 106.456"
        order = x.OrderIndex
    }));
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<section class="routes-1 position-relative" style="height: 250px; background: #222;">
    <div class="container mx-auto position-relative z-1 h-100">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div>
                <h2 class="text-center text-white text-uppercase">@Model.Route.RouteName</h2>
                <p class="text-center text-white-50">Chi tiết lộ trình & Điều hướng</p>
            </div>
        </div>
    </div>
</section>

<section class="route-detail py-5 bg-light">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-8">
                <h3 class="fw-bold mb-3">@Model.Route.RouteName</h3>
                <p class="text-muted">
                    Hệ thống tự động cập nhật lộ trình thực tế. Bấm nút "Start Navigation" để tìm trạm gần bạn nhất.
                </p>

                <div class="rounded-4 overflow-hidden shadow-sm position-relative" style="height: 400px; border: 1px solid #ddd;">
                    <div id="map" style="width: 100%; height: 100%;"></div>

                    <div id="loading-loc" class="position-absolute top-50 start-50 translate-middle bg-white p-3 rounded shadow d-none" style="z-index: 1000;">
                        <div class="spinner-border text-warning" role="status"></div>
                        <span class="ms-2">Đang định vị...</span>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0">
                <div class="card p-4 border-0 shadow-sm rounded-4 h-100 bg-white">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="fw-bold text-warning mb-1">Route @Model.RouteId</h5>
                            <small class="text-muted">@Model.Route.RouteName</small>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2">@Model.Vehicle?.VehicleType</span>
                    </div>

                    <hr class="my-4">

                    <div class="row text-center mb-4">
                        <div class="col-6 mb-3">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.8rem;">Thời gian</small>
                            <span class="fw-bold fs-5"><i class="far fa-clock text-warning me-1"></i> 25 mins</span>
                        </div>
                        <div class="col-6 mb-3">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.8rem;">Giá vé</small>
                            <span class="fw-bold fs-5 text-warning">@Model.Route.BasePrice.ToString("N0")đ</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.8rem;">Đi bộ</small>
                            <span class="fw-bold fs-5" id="walking-distance">...</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block text-uppercase" style="font-size: 0.8rem;">Chuyến sau</small>
                            <span class="fw-bold fs-5 text-success">5 mins</span>
                        </div>
                    </div>

                    <button onclick="startNavigation()" class="btn btn-warning w-100 fw-bold text-white py-3 rounded-pill shadow-sm mb-3 text-uppercase">
                        <i class="fas fa-location-arrow me-2"></i> Start Navigation
                    </button>

                    <div id="nav-result" class="alert alert-info small d-none">
                        📍 Bạn đang cách trạm <b><span id="nearest-station-name"></span></b> khoảng <b><span id="distance-val"></span></b>.
                        <a href="#" id="google-map-link" target="_blank" class="d-block mt-1 fw-bold">Xem chỉ đường Google Maps &rarr;</a>
                    </div>

                    <div class="mt-auto">
                        <h6 class="fw-bold mb-3">Các chuyến tiếp theo</h6>
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>08:00 AM</span> <span class="text-muted small">Trip 1</span>
                        </div>
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>08:15 AM</span> <span class="text-muted small">Trip 2</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <h4 class="fw-bold mb-4">Steps to Destination</h4>
                <div class="timeline ps-3 ms-2">
                    <div class="timeline-item mb-5 position-relative ps-5">
                        <div class="position-absolute top-0 start-0 translate-middle rounded-circle bg-white border border-2 border-warning d-flex align-items-center justify-content-center"
                             style="width: 40px; height: 40px; left: -1px;">
                            <i class="fas fa-walking text-warning"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Đi bộ đến trạm đón</h6>
                        <small class="text-muted">Di chuyển đến trạm gần nhất để bắt xe.</small>
                    </div>

                    @foreach (var detail in Model.Route.RouteDetails)
                    {
                        <div class="timeline-item mb-4 position-relative ps-5">
                            <div class="position-absolute top-0 start-0 translate-middle rounded-circle bg-warning text-white d-flex align-items-center justify-content-center shadow-sm"
                                 style="width: 40px; height: 40px; left: -1px;">
                                <i class="fas fa-bus"></i>
                            </div>

                            <h6 class="fw-bold mb-1">
                                @detail.Station.StationName
                                @if (detail.IsMajorStop)
                                {
                                    <span class="badge bg-danger ms-2" style="font-size: 0.7rem;">Trạm chính</span>
                                }
                            </h6>
                            <small class="text-muted d-block">@detail.Station.Address</small>
                            <small class="text-success"><i class="fas fa-clock me-1"></i> @Model.DepartureTime.AddMinutes(detail.DistanceFromStart * 2).ToString("HH:mm")</small>
                        </div>
                    }

                    <div class="timeline-item mb-0 position-relative ps-5">
                        <div class="position-absolute top-0 start-0 translate-middle rounded-circle bg-success text-white d-flex align-items-center justify-content-center"
                             style="width: 40px; height: 40px; left: -1px;">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <h6 class="fw-bold mb-1">Kết thúc hành trình</h6>
                        <small class="text-muted">Bạn đã đến điểm cuối.</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
    // 1. Lấy dữ liệu trạm từ C#
    var stations = @Html.Raw(stationsJson);

    // 2. Khởi tạo bản đồ (Tọa độ mặc định HCM)
    var map = L.map('map').setView([10.8231, 106.6297], 12);

    // 3. Thêm lớp bản đồ OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // 4. Vẽ các trạm lên bản đồ
    var markers = [];
    stations.forEach(function(station) {
        var coords = station.coords.split(',').map(Number);
        if(coords.length === 2) {
            var marker = L.marker(coords).addTo(map)
                .bindPopup("<b>" + station.name + "</b><br>" + station.address);
            markers.push(marker);
        }
    });

    // 5. Hàm tính khoảng cách (Haversine Formula)
    function getDistance(lat1, lon1, lat2, lon2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * (Math.PI / 180);
        var dLon = (lon2 - lon1) * (Math.PI / 180);
        var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                Math.cos(lat1 * (Math.PI / 180)) * Math.cos(lat2 * (Math.PI / 180)) *
                Math.sin(dLon / 2) * Math.sin(dLon / 2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
        return R * c;
    }

    // 6. Xử lý khi bấm nút "Start Navigation"
    function startNavigation() {
        var btnLoading = document.getElementById('loading-loc');
        var navResult = document.getElementById('nav-result');

        btnLoading.classList.remove('d-none'); // Hiện loading

        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                var userLat = position.coords.latitude;
                var userLng = position.coords.longitude;

                // Thêm marker User (Màu đỏ)
                var userIcon = L.icon({
                    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/markers/marker-icon-red.png',
                    iconSize: [25, 41],
                    iconAnchor: [12, 41],
                    popupAnchor: [1, -34]
                });

                // Xóa marker cũ nếu có (để tránh spam marker khi bấm nhiều lần)
                map.eachLayer(function (layer) {
                    if (layer.options.icon && layer.options.icon.options.iconUrl.includes('marker-icon-red')) {
                        map.removeLayer(layer);
                    }
                });

                L.marker([userLat, userLng], {icon: userIcon}).addTo(map)
                    .bindPopup("<b>Vị trí của bạn</b>").openPopup();

                // Tìm trạm gần nhất
                var minDistance = 99999;
                var nearestStation = null;

                stations.forEach(function(station) {
                    var coords = station.coords.split(',').map(Number);
                    var dist = getDistance(userLat, userLng, coords[0], coords[1]);

                    if (dist < minDistance) {
                        minDistance = dist;
                        nearestStation = station;
                    }
                });

                // Cập nhật giao diện
                btnLoading.classList.add('d-none');
                navResult.classList.remove('d-none');

                if (nearestStation) {
                    // Update Text
                    document.getElementById('nearest-station-name').innerText = nearestStation.name;
                    document.getElementById('distance-val').innerText = minDistance.toFixed(2) + " km";
                    document.getElementById('walking-distance').innerText = (minDistance * 1000).toFixed(0) + "m";

                    // --- SỬA LỖI LINK GOOGLE MAPS TẠI ĐÂY ---
                    // Tách tọa độ trạm ra thành mảng số [Lat, Lng]
                    var destCoords = nearestStation.coords.split(',').map(item => item.trim());

                    // Link chuẩn của Google Maps: origin = User, destination = Trạm
                    var gMapLink = `https://www.google.com/maps/dir/?api=1&origin=${userLat},${userLng}&destination=${destCoords[0]},${destCoords[1]}&travelmode=walking`;

                    document.getElementById('google-map-link').href = gMapLink;

                    // Zoom map để thấy cả 2 điểm
                    var bounds = L.latLngBounds([
                        [userLat, userLng],
                        [parseFloat(destCoords[0]), parseFloat(destCoords[1])]
                    ]);
                    map.fitBounds(bounds, {padding: [50, 50]});
                }

            }, function(error) {
                alert("Lỗi: Không thể lấy vị trí. Hãy bật GPS trình duyệt!");
                btnLoading.classList.add('d-none');
            });
        } else {
            alert("Trình duyệt không hỗ trợ định vị.");
        }
    }
</script>