@model Public_Transport.Models.Entities.Trip
@{
    ViewData["Title"] = "Trip Detail: " + (Model.Route?.RouteName ?? "Unknown");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="routes-1 position-relative" style="height: 300px; background: url('/assets/images/bus.jpg') no-repeat center center/cover;">
    <div class="bg-overlay position-absolute bg-black opacity-75 start-0 top-0 w-100 h-100"></div>
    <div class="container mx-auto position-relative z-1 h-100">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div>
                <h2 class="text-center text-white">TRIP DETAILS</h2>
                <ul class="d-flex justify-content-center gap-1 list-unstyled">
                    <li><a href="/" class="text-white fs-6 fw-light font-secondary text-decoration-none">Home</a></li>
                    <li><span class="color-primary text-white mx-2"><i class="fa-solid fa-angle-right"></i></span></li>
                    <li><span class="text-white fs-6 fw-light font-secondary">@Model.Route.RouteName</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="route-detail py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <h2 class="fw-bold mb-3">@Model.Route.RouteName</h2>
                <p class="text-muted">@Model.Route.Description</p>

                <div class="rounded-4 overflow-hidden mb-4 bg-light shadow-sm" style="height: 400px; position: relative;">
                    <div id="map" class="w-100 h-100"></div>
                </div>

                <h4 class="fw-bold mb-4">Detailed Itinerary</h4>
                <div class="timeline">
                    <div class="timeline-item">
                        <div class="timeline-icon bg-success text-white">
                            <i class="fas fa-play"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Departure</h6>
                        <small class="text-muted">
                            <i class="fa-solid fa-clock me-1"></i> @Model.DepartureTime.ToString("HH:mm dd/MM/yyyy")
                        </small>
                    </div>

                    @if (Model.Route.RouteDetails != null)
                    {
                        foreach (var item in Model.Route.RouteDetails)
                        {
                            <div class="timeline-item">
                                <div class="timeline-icon @(item.IsMajorStop ? "bg-warning text-white" : "")">
                                    @if (item.IsMajorStop) { <i class="fas fa-star"></i> }
                                    else { <i class="fas fa-map-marker-alt"></i> }
                                </div>

                                <h6 class="fw-bold mb-0">@item.Station.StationName</h6>
                                
                                <small class="text-muted d-block">
                                    @if(item.DistanceFromStart > 0) { <span>From start: @item.DistanceFromStart km</span> }
                                    else { <span>Start Point</span> }
                                </small>
                                <small class="text-secondary" style="font-size: 0.85rem;">
                                    <i class="fa-solid fa-location-dot me-1"></i> @item.Station.Address
                                </small>
                            </div>
                        }
                    }

                    <div class="timeline-item">
                        <div class="timeline-icon bg-danger text-white">
                            <i class="fas fa-flag-checkered"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Arrival</h6>
                        <small class="text-muted">Est. Arrival: @Model.ArrivalTime.ToString("HH:mm")</small>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card p-4 mb-4 shadow-sm border-0">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="fw-bold text-warning mb-0">Information</h4>
                        <span class="badge bg-success rounded-pill">
                            @(Model.Vehicle?.VehicleType ?? "Bus")
                        </span>
                    </div>
                    <hr>
                    <div class="row g-3 text-center mb-4">
                        <div class="col-6">
                            <small class="text-muted d-block">Fare</small>
                            <span class="fw-bold"><i class="fas fa-ticket-alt text-warning"></i> @Model.Route.BasePrice.ToString("N0") VND</span>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Total Distance</small>
                            <span class="fw-bold"><i class="fas fa-road text-warning"></i> @Model.Route.TotalDistance km</span>
                        </div>
                        <div class="col-12">
                            <small class="text-muted d-block">Status</small>
                            <span class="fw-bold text-success">@Model.Status</span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="button" button-start class="btn btn-warning fw-bold rounded-pill py-2 shadow-sm text-white">
                            <i class="fas fa-location-arrow me-2"></i> NAVIGATE TO STATION
                        </button>
                        <button type="button" id="btn-toggle-directions" class="btn btn-outline-secondary btn-sm rounded-pill d-none py-2">
                            <i class="fas fa-list-ul me-1"></i> View Instructions
                        </button>
                    </div>
                </div>

                @if (Model.Driver != null)
                {
                    <div class="card p-4 shadow-sm border-0">
                        <h6 class="fw-bold mb-3">Assigned Driver</h6>
                        <div class="d-flex align-items-center">
                            <div class="bg-light rounded-circle p-3 me-3"><i class="fas fa-user-tie fa-lg text-secondary"></i></div>
                            <div>
                                <h6 class="mb-0 fw-bold">@Model.Driver.User?.FullName</h6>
                                <small class="text-muted">License: @Model.Driver.LicenseNumber (@Model.Driver.ExperienceYears years exp)</small>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // --- STEP 1: Fetch Data ---
        var routeData = @Html.Raw(Json.Serialize(Model.Route.RouteDetails.Select(x => new {
            name = x.Station.StationName,
            address = x.Station.Address,
            lat = x.Station.Latitude,
            lng = x.Station.Longitude,
            order = x.OrderIndex,
            isMajor = x.IsMajorStop 
        })));

        if (!routeData || routeData.length === 0) {
            console.error("No station data found!");
            return;
        }

        // --- STEP 2: Init Map ---
        if (typeof L === 'undefined') {
            console.error("Leaflet library not loaded!");
            return;
        }

        // Set initial view to the first station
        var startPoint = routeData[0];
        var map = L.map('map').setView([startPoint.lat, startPoint.lng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        // --- STEP 3: Draw Markers (Major vs Minor) & Bus Route ---
        var waypoints = [];
        
        routeData.forEach(function (station) {
            var latLng = L.latLng(station.lat, station.lng);
            waypoints.push(latLng);

            // LOGIC: Differentiate Major vs Minor Stops
            if (station.isMajor === true) {
                // MAJOR STOP: Standard Blue Pin
                L.marker(latLng).addTo(map)
                    .bindPopup(`<b style="color:#d35400">★ MAJOR STOP</b><br><b>${station.name}</b><br><i>${station.address}</i>`);
            } else {
                // MINOR STOP: Small White Dot
                L.circleMarker(latLng, {
                    radius: 6,
                    fillColor: "#ffffff",
                    color: "#333",
                    weight: 2,
                    opacity: 1,
                    fillOpacity: 1
                }).addTo(map)
                .bindPopup(`<b>Station #${station.order}:</b><br>${station.name}`);
            }
        });

        // Draw the Bus Route (Yellow Line)
        if (typeof L.Routing !== 'undefined') {
            L.Routing.control({
                waypoints: waypoints,
                lineOptions: {
                    styles: [{ color: '#FFBA00', weight: 6, opacity: 0.8 }] // Yellow for Bus
                },
                createMarker: function () { return null; }, // Hide default routing markers
                addWaypoints: false,
                draggableWaypoints: false,
                show: false,
                fitSelectedRoutes: true
            }).addTo(map);
        }

        // --- STEP 4: Smart Navigation Logic ---
        let isNavigating = false;
        let routingToStation = null;
        let userMarker = null;
        const buttonStart = document.querySelector("[button-start]");
        const btnToggle = document.getElementById("btn-toggle-directions");

        if (buttonStart) {
            buttonStart.addEventListener("click", function () {
                if (!isNavigating) {
                    // Start Navigation
                    alert("Locating you and finding the nearest station...");

                    map.locate({ setView: true, watch: true, enableHighAccuracy: true });

                    map.once('locationfound', function (e) {
                        const userLocation = e.latlng;

                        // Algorithm: Find Nearest Station
                        let nearestStation = null;
                        let minDistance = Infinity;

                        routeData.forEach(function (station) {
                            var stationLatLng = L.latLng(station.lat, station.lng);
                            var dist = userLocation.distanceTo(stationLatLng); // Leaflet built-in method (meters)
                            
                            if (dist < minDistance) {
                                minDistance = dist;
                                nearestStation = station;
                            }
                        });

                        if (nearestStation) {
                            const destLatLng = L.latLng(nearestStation.lat, nearestStation.lng);

                            if (routingToStation) map.removeControl(routingToStation);

                            // Draw Walking Route (Blue Dashed Line)
                            routingToStation = L.Routing.control({
                                waypoints: [userLocation, destLatLng],
                                lineOptions: {
                                    styles: [{ color: '#3b82f6', weight: 5, opacity: 0.8, dashArray: '10, 10' }]
                                },
                                router: L.Routing.osrmv1({ profile: 'foot' }), // Walking profile
                                createMarker: function () { return null; },
                                addWaypoints: false,
                                show: true // Show instructions
                            }).addTo(map);

                            // Notify User
                            L.popup()
                                .setLatLng(userLocation)
                                .setContent(`<b>You are here</b><br>Nearest Station: <b>${nearestStation.name}</b><br>Distance: ${Math.round(minDistance)}m`)
                                .openOn(map);

                            // Draw User Marker
                            if (userMarker) map.removeLayer(userMarker);
                            userMarker = L.marker(userLocation).addTo(map);
                        }

                        // Show Toggle Button
                        setTimeout(() => {
                            const container = document.querySelector('.leaflet-right');
                            if (container) container.classList.add('routing-hidden');
                            btnToggle.classList.remove('d-none');
                        }, 1000);
                    });

                    this.innerHTML = '<i class="fas fa-stop-circle me-2"></i> STOP NAVIGATION';
                    this.classList.replace("btn-warning", "btn-danger");
                    isNavigating = true;

                } else {
                    // Stop Navigation
                    map.stopLocate();
                    if (routingToStation) {
                        map.removeControl(routingToStation);
                        routingToStation = null;
                    }
                    if (userMarker) {
                        map.removeLayer(userMarker);
                    }
                    map.setView([startPoint.lat, startPoint.lng], 13); // Reset view
                    
                    btnToggle.classList.add('d-none');
                    this.innerHTML = '<i class="fas fa-location-arrow me-2"></i> NAVIGATE TO STATION';
                    this.classList.replace("btn-danger", "btn-warning");
                    isNavigating = false;
                }
            });
        }

        // Toggle Instructions Panel
        if (btnToggle) {
            btnToggle.addEventListener("click", function () {
                const container = document.querySelector('.leaflet-right');
                if (container) {
                    container.classList.toggle('routing-hidden');
                }
            });
        }
    });
</script>