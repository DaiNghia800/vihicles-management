@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <div class="hero-bg-animate"></div>
    <div class="hero-overlay"></div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9 hero-content">

                <h1 class="hero-title">
                    Smart Travel with <span class="text-highlight">Driveria</span> <br>
                    Travel Smarter
                </h1>

                <p class="hero-desc">
                    Experience the most comfortable and safe bus travel across the country.
                    Book tickets easily, view real-time schedules, and enjoy premium services
                    at affordable prices.
                </p>

                <div class="hero-btns">
                    <a href="/trip" class="btn-primary-custom">
                        Find A Trip
                    </a>

                    <a href="#" class="btn-video-custom">
                        <div class="icon-box">
                            <i class="fas fa-search-location"></i>
                        </div>
                        <span>View Routes</span>
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="features-overlap">
    <div class="container">
        <div class="row g-4">

            <div class="col-lg-3 col-md-6">
                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fas fa-ticket-alt"></i>
                    </div>
                    <h3 class="feature-title">Best Prices</h3>
                    <p class="feature-desc">
                        Competitive fares and exclusive deals for online bookings. Save more on every trip.
                    </p>
                    <a href="#" class="read-more-link">
                        Book Now <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-box">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h3 class="feature-title">Safe Travel</h3>
                    <p class="feature-desc">
                        Professional drivers and well-maintained vehicles ensuring your safety on every mile.
                    </p>
                    <a href="#" class="read-more-link">
                        Learn More <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
            </div>

            <div class="col-lg-6 col-md-6  d-flex">
                <div class="feature-box highlight col-lg-6">
                    <div class="feature-icon">
                        <i class="fas fa-map-marked-alt"></i>
                    </div>
                    <h3 class="feature-title">Wide Network</h3>
                    <p class="feature-desc">
                        Connecting major cities and tourist destinations with thousands of daily schedules.
                    </p>
                    <a href="#" class="read-more-link">
                        View Map <i class="fas fa-arrow-right"></i>
                    </a>
                </div>
                <div class="feature-image-box" style="background-image: url('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=2069&auto=format&fit=crop'); background-size: cover;"></div>
            </div>

        </div>
    </div>
</section>

<section class="about-section">
    <div class="container">
        <div class="row align-items-center">

            <div class="col-lg-6">
                <div class="img-stack-wrapper">
                    <img src="https://images.unsplash.com/photo-1570125909232-eb263c188f7e?q=80&w=2071&auto=format&fit=crop"
                         alt="Bus Travel" class="img-main">

                    <img src="https://images.unsplash.com/photo-1532939163844-547f958e91b4?q=80&w=1888&auto=format&fit=crop"
                         alt="Happy Passenger" class="img-overlay">
                </div>
            </div>

            <div class="col-lg-6 ps-lg-5">
                <span class="sub-title">Why Choose Us</span>
                <h2 class="section-title">Connecting Cities, Connecting People With Comfort</h2>
                <p class="section-desc">
                    We redefine public transport with a focus on punctuality, comfort, and customer satisfaction.
                    Whether you are traveling for business or leisure, we get you there relaxed and on time.
                </p>

                <div class="row">
                    <div class="col-md-6">
                        <ul class="check-list">
                            <li><i class="fas fa-check text-warning me-2"></i> Free High-Speed Wi-Fi</li>
                            <li><i class="fas fa-check text-warning me-2"></i> Reclining Leather Seats</li>
                            <li><i class="fas fa-check text-warning me-2"></i> USB Charging Ports</li>
                            <li><i class="fas fa-check text-warning me-2"></i> Air Conditioning</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <ul class="check-list">
                            <li><i class="fas fa-check text-warning me-2"></i> GPS Tracking</li>
                            <li><i class="fas fa-check text-warning me-2"></i> 24/7 Customer Support</li>
                            <li><i class="fas fa-check text-warning me-2"></i> Easy Online Cancellation</li>
                            <li><i class="fas fa-check text-warning me-2"></i> Verified Drivers</li>
                        </ul>
                    </div>
                </div>

                <div class="fun-fact-box">
                    <div class="fun-fact-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="fun-fact-content">
                        <h4>10M+</h4>
                        <span>Happy Passengers</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<section class="lessons-section">
    <div class="container">

        <div class="section-header-center">
            <span class="sub-title">Our Fleet</span>
            <h2 class="section-title">Premium Bus Services</h2>
            <p class="section-desc">
                Choose the travel experience that suits your needs. From express shuttles to luxury sleepers.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">
                <div class="lesson-card">
                    <div class="lesson-img-wrapper">
                        
                        <img src="https://images.unsplash.com/photo-1532939163844-547f958e91b4?q=80&w=2069&auto=format&fit=crop"
                             class="lesson-img" alt="Express Bus">
                    </div>
                    <div class="lesson-content-box">
                        <i class="fas fa-bus lesson-icon-font" style="-webkit-text-stroke: 1px var(--brand-yellow); color: transparent; font-size: 3.5rem;"></i>

                        <h3 class="lesson-title">Express Seater</h3>
                        <p class="lesson-desc">
                            Fast and economical travel for short to medium distances. Comfortable seating with ample legroom.
                        </p>
                        <a href="/trip" class="read-more-link">
                            View Schedule <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="lesson-card">
                    <div class="lesson-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?q=80&w=2069&auto=format&fit=crop"
                             class="lesson-img" alt="Sleeper Bus">
                    </div>
                    <div class="lesson-content-box">
                        <i class="fas fa-bed lesson-icon-font" style="-webkit-text-stroke: 1px var(--brand-yellow); color: transparent; font-size: 3.5rem;"></i>

                        <h3 class="lesson-title">Luxury Sleeper</h3>
                        <p class="lesson-desc">
                            Travel overnight in comfort with our fully flat beds, personal curtains, and entertainment systems.
                        </p>
                        <a href="#" class="read-more-link">
                            View Schedule <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="lesson-card">
                    <div class="lesson-img-wrapper">
                        <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?q=80&w=2070&auto=format&fit=crop"
                             class="lesson-img" alt="Limousine">
                    </div>
                    <div class="lesson-content-box">
                        <i class="fas fa-crown lesson-icon-font" style="-webkit-text-stroke: 1px var(--brand-yellow); color: transparent; font-size: 3.5rem;"></i>

                        <h3 class="lesson-title">Royal Limousine</h3>
                        <p class="lesson-desc">
                            The ultimate VIP experience. Massage chairs, snacks, drinks, and fewer stops for a faster trip.
                        </p>
                        <a href="#" class="read-more-link">
                            View Schedule <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>

        </div>

        <div class="lesson-cta-footer">
            Ready to explore new destinations?
            <a href="/admin/trip/index" class="cta-link-yellow">Book Tickets Now <i class="fas fa-arrow-right"></i></a>
        </div>

    </div>
</section>

<section class="video-cta-section" style="background: url('https://images.unsplash.com/photo-1469854523086-cc02fe5d8800?q=80&w=2021&auto=format&fit=crop') no-repeat center center/cover;">
    <div class="video-cta-overlay"></div>

    <div class="container">
        <div class="video-cta-content">

            <a href="#" class="play-btn-large">
                <i class="fas fa-play"></i>
            </a>

            <h2 class="cta-title">
                Explore The Beauty of The Country With Fastkart
            </h2>

            <p class="cta-desc">
                Thousands of routes, millions of smiles. Join our community of travelers today.
            </p>

            <a href="/sign-up" class="btn-cta-yellow">
                Register Account
            </a>

        </div>
    </div>
</section>

<section class="blog-section">
    <div class="container">
        <div class="section-header-center">
            <span class="sub-title">Travel Blog</span>
            <h2 class="section-title">Latest Travel Guides & News</h2>
            <p class="section-desc">
                Tips, destination guides, and updates from the world of travel.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="blog-card">
                    <div class="blog-thumb">
                        <span class="blog-category">Guide</span>
                        <img src="https://images.unsplash.com/photo-1504150558240-0b4fd8946624?q=80&w=1964&auto=format&fit=crop" class="blog-img" alt="Blog 1">
                    </div>
                    <h3 class="blog-title">
                        <a href="#">Top 10 Must-Visit Destinations This Summer</a>
                    </h3>
                    <p class="blog-excerpt">
                        Discover the hidden gems and popular spots that are perfect for your next summer vacation...
                    </p>
                    <a href="#" class="read-more-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="blog-card">
                    <div class="blog-thumb">
                        <span class="blog-category">Tips</span>
                        <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=2070&auto=format&fit=crop" class="blog-img" alt="Blog 2">
                    </div>
                    <h3 class="blog-title">
                        <a href="#">How to Pack Light for a Long Bus Journey</a>
                    </h3>
                    <p class="blog-excerpt">
                        Traveling by bus can be long. Here are some essential packing tips to keep you comfortable...
                    </p>
                    <a href="#" class="read-more-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="blog-card">
                    <div class="blog-thumb">
                        <span class="blog-category">News</span>
                        <img src="https://images.unsplash.com/photo-1570125909232-eb263c188f7e?q=80&w=2071&auto=format&fit=crop" class="blog-img" alt="Blog 3">
                    </div>
                    <h3 class="blog-title">
                        <a href="#">New Routes Added: Connecting North and South</a>
                    </h3>
                    <p class="blog-excerpt">
                        We are excited to announce new express routes connecting major northern cities to the south...
                    </p>
                    <a href="#" class="read-more-link">Read More <i class="fas fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>