@{
    Layout = null;
}
<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .access-denied-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .access-denied-box {
        background: white;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        text-align: center;
        max-width: 500px;
        width: 100%;
        animation: fadeIn 0.5s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .access-denied-icon {
        font-size: 80px;
        color: #dc3545;
        margin-bottom: 20px;
        animation: shake 0.5s ease-in-out;
    }

    @@keyframes shake {
        0%, 100% {
            transform: rotate(0deg);
        }

        25% {
            transform: rotate(-10deg);
        }

        75% {
            transform: rotate(10deg);
        }
    }

    .access-denied-title {
        font-size: 28px;
        font-weight: bold;
        color: #333;
        margin-bottom: 15px;
    }

    .access-denied-message {
        font-size: 16px;
        color: #666;
        margin-bottom: 30px;
        line-height: 1.6;
    }

    /* CSS từ file style.css cho btn */
    .btn {
        font-size: 1.0625rem;
        font-weight: 400;
        padding: 0.625rem 1.125rem;
    }

        .btn:hover {
            background-color: var(--theme-color);
            color: white;
            border-color: none;
            box-shadow: none;
        }

    /* CSS cho btn-process */
    .btn-process {
        background-color: var(--theme-color);
        color: #fff;
     
    }

    /* CSS cho btn-animation */
    .btn-animation {
        display: flex;
        align-items: center;
        background: linear-gradient(90deg, #ff6b6b 0%, #ff4f4f 100%);
        color: #fff;
        border-radius: 0.3125rem;
        z-index: 0;
        position: relative;
        padding: 0.625rem;
        justify-content: center;
        overflow: hidden;
        border: none;
        font-weight: 600;
        gap: 8px;
        transition: all 0.3s ease;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-animation::after {
            content: "";
            position: absolute;
            width: 100%;
            height: 0;
            bottom: 0;
            left: 0;
            z-index: -1;
            border-radius: 0.3125rem;
            background: #ff4f4f;
            background: linear-gradient(90deg, #ff4f4f 0%, #ff6b6b 100%);
            transition: all .3s ease;
        }

        .btn-animation:hover {
            color: #fff;
        }

            .btn-animation:hover::after {
                top: 0;
                height: 100%;
            }

    /* CSS đặc biệt cho btn-process.btn-animation */
    .btn-process.btn-animation {
        background: #0da487 !important;
    }

        .btn-process.btn-animation::after {
            background: linear-gradient(90deg, #0e947a 0%, #0da487 100%);
        }

        .btn-process.btn-animation i {
            font-size: 18px;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .access-denied-box {
            padding: 30px 25px;
            margin: 0 15px;
        }

        .access-denied-icon {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .access-denied-title {
            font-size: 24px;
            margin-bottom: 12px;
        }

        .access-denied-message {
            font-size: 14px;
            margin-bottom: 25px;
        }

        .btn-animation {
            padding: 10px 25px;
            font-size: 14px;
        }
    }

    @@media (max-width: 480px) {
        .access-denied-container {
            padding: 15px;
        }

        .access-denied-box {
            padding: 25px 20px;
        }

        .access-denied-icon {
            font-size: 50px;
            margin-bottom: 12px;
        }

        .access-denied-title {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .access-denied-message {
            font-size: 13px;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .btn-animation {
            padding: 10px 20px;
            font-size: 13px;
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 360px) {
        .access-denied-box {
            padding: 20px 15px;
        }

        .access-denied-icon {
            font-size: 45px;
        }

        .access-denied-title {
            font-size: 18px;
        }

        .access-denied-message {
            font-size: 12px;
        }
    }

    /* Dark Mode Support (Optional) */
    @@media (prefers-color-scheme: dark) {
        .access-denied-box {
            background: #1a1a1a;
        }

        .access-denied-title {
            color: #fff;
        }

        .access-denied-message {
            color: #ccc;
        }
    }

    /* Theme color variable */
    :root {
        --theme-color: #0baf9a;
    }
</style>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <title>Access Denied - Admins Only</title>
</head>
<body>
    <div class="access-denied-container">
        <div class="access-denied-box">
            <div class="access-denied-icon">
                <i class="bi bi-shield-lock"></i>
            </div>
            <h1 class="access-denied-title">Access Denied</h1>
            <p class="access-denied-message">
                You do not have permission to access this page.
                <br>This area is restricted to administrators only.
                <br>Please contact the system administrator if you believe this is an error.
            </p>
            <a href="javascript:history.back()" class="btn btn-process btn-animation mt-0 text-white" style="text-decoration: none;">
                <i class="bi bi-arrow-left"></i>
                <span>Go Back</span>
            </a>
        </div>
    </div>
</body>
</html>