@{
    Layout = "_Layout";
    ViewData["title"] = "Blog detail";
}
<section class="routes-1 position-relative" style="height: 300px; background: url('/assets/images/bus.jpg') no-repeat center center/cover;">
    <div class="bg-overlay position-absolute bg-black opacity-75 start-0 top-0 w-100 h-100"></div>
    <div class="container mx-auto position-relative z-1 h-100">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div>
                <h2 class="text-center text-white">BLOG</h2>
                <ul class="d-flex justify-content-center gap-1 list-unstyled">
                    <li><span class="text-white fs-6 fw-light font-secondary">Home</span></li>
                    <li><span class="color-primary text-white mx-2"><i class="fa-solid fa-angle-right"></i></span></li>
                    <li><span class="text-white fs-6 fw-light font-secondary">Blog Detail</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>
<section class="single-blog-section">
    <div class="container">
        <div class="row">
            <!-- Blog Post Content Column -->
            <div class="col-lg-8 col-md-8">
                <article class="single-blog-post" id="blogDetailContainer">
                    <div class="text-center py-5" id="loadingBlog">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading blog...</p>
                    </div>
                </article>
            </div>

            <!-- Sidebar (Partial View) -->
            @await Html.PartialAsync("_BlogSidebar")
        </div>
    </div>
</section>

<!-- Include shared sidebar script -->
<script src="~/js/blog-sidebar.js"></script>

<script>
    let blog = null;

    document.addEventListener('DOMContentLoaded', function () {
        const blogId = '@ViewData["BlogId"]';

        if (blogId && blogId !== '') {
            loadBlogDetail(blogId);
            // Load sidebar with current blog ID to exclude it from recent posts
            loadSidebarData(blogId);
        } else {
            showError('Blog not found');
        }
    });

    async function loadBlogDetail(id) {
        try {
            const response = await fetch(`/blog/api/detail/${id}`);
            if (response.ok) {
                blog = await response.json();
                renderBlogDetail();
            } else {
                showError('Blog not found');
            }
        } catch (error) {
            console.error('Error loading blog:', error);
            showError('Error loading blog');
        }
    }

    function renderBlogDetail() {
        const container = document.getElementById('blogDetailContainer');
        const hasImage = blog.imageUrl && blog.imageUrl.trim() !== '';

        container.innerHTML = `
            <div class="featured-image">
                <img src="${hasImage ? blog.imageUrl : './img/male-instructor-happy-with-driving-of-his-student-e1627375376155.jpg'}"
                    alt="${blog.title}">
            </div>

            <div class="post-content">
                <div class="post-meta mb-3">
                    <span class="badge bg-primary">${blog.categoryName}</span>
                    <span class="ms-2"><i class="fa-regular fa-user"></i> ${blog.authorName}</span>
                    <span class="ms-2"><i class="fa-regular fa-calendar"></i> ${formatDate(blog.createdAt)}</span>
                </div>
                <h2 class="mb-4">${blog.title}</h2>
                <div class="post-text blog-content">
                    ${blog.content}
                </div>
            </div>

            <div class="post-footer">
                <div class="post-tags">
                    <span class="tags-label">Tags :</span>
                    <a href="/blog" class="tag-link">${blog.categoryName}</a>
                </div>
                <div class="post-share">
                    <span class="share-label">Share This :</span>
                    <div class="share-buttons">
                        <a href="#" class="share-btn facebook">
                            <i class="fa-brands fa-facebook-f"></i>
                        </a>
                        <a href="#" class="share-btn twitter">
                          <i class="fa-brands fa-x-twitter"></i>
                        </a>
                        <a href="#" class="share-btn linkedin">
                           <i class="fa-brands fa-linkedin-in"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="comments-section">
                <h3 class="section-title">Leave a Reply</h3>
                <p class="comment-note">Your email address will not be published. Required fields are marked *</p>

                <form class="comment-form" onsubmit="submitComment(event)">
                    <div class="form-group mb-4">
                        <label for="comment">Comment *</label>
                        <textarea class="form-control" id="comment" rows="6" required></textarea>
                    </div>

                    <div class="form-group mb-4">
                        <label for="name">Name *</label>
                        <input type="text" class="form-control" id="name" required>
                    </div>

                    <div class="form-group mb-4">
                        <label for="email">Email *</label>
                        <input type="email" class="form-control" id="email" required>
                    </div>

                    <div class="form-group mb-4">
                        <label for="website">Website</label>
                        <input type="url" class="form-control" id="website">
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" id="saveInfo">
                        <label class="form-check-label" for="saveInfo">
                            Save my name, email, and website in this browser for the next time I comment.
                        </label>
                    </div>

                    <button type="submit" class="btn-submit-comment">POST COMMENT</button>
                </form>
            </div>
        `;
    }

    function showError(message) {
        const container = document.getElementById('blogDetailContainer');
        container.innerHTML = `
            <div class="text-center py-5">
                <i class="fa-solid fa-exclamation-circle fa-3x text-danger mb-3"></i>
                <h4>${message}</h4>
                <a href="/blog" class="btn btn-primary mt-3">Back to Blog List</a>
            </div>
        `;
    }

    function submitComment(event) {
        event.preventDefault();
        alert('Comment feature coming soon!');
    }
</script>

<style>
    .blog-content {
        line-height: 1.8;
        font-size: 16px;
    }

        .blog-content p {
            margin-bottom: 1.5rem;
        }

        .blog-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 1rem 0;
        }

        .blog-content h1, .blog-content h2, .blog-content h3 {
            margin-top: 2rem;
            margin-bottom: 1rem;
        }

    .post-meta .badge {
        font-size: 0.85rem;
    }
</style>