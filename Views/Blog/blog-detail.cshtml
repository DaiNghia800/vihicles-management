@{
    Layout = "_Layout";
    ViewData["title"] = "Blog Detail";
    var blogId = ViewData["BlogId"]?.ToString();
}
<style>
    .blog-detail-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .blog-header-image {
        width: 100%;
        height: 400px;
        overflow: hidden;
    }

        .blog-header-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .blog-meta {
        padding: 20px 30px;
        border-bottom: 1px solid #eee;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        font-size: 14px;
        color: #666;
    }

    .category-badge {
        background: #ffba00;
        color: black;
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .separator {
        color: #ddd;
    }

    .author-name, .blog-date {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .blog-title {
        font-size: 32px;
        font-weight: 700;
        color: #333;
        padding: 30px 30px 20px;
        margin: 0;
        line-height: 1.4;
    }

    .blog-content {
        padding: 0 30px 30px;
        font-size: 16px;
        line-height: 1.8;
        color: #555;
    }

        .blog-content p {
            margin-bottom: 20px;
        }

        .blog-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 20px 0;
        }

        .blog-content h2, .blog-content h3 {
            margin-top: 30px;
            margin-bottom: 15px;
            color: #333;
        }

    .spinner-border {
        width: 3rem;
        height: 3rem;
        border-width: 0.3rem;
    }

    .btn-primary {
        background-color: #ffba00;
        border: none;
        padding: 12px 30px;
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s;
    }

        .btn-primary:hover {
            background-color: #e5a800;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 186, 0, 0.3);
        }
</style>
<section class="routes-1 position-relative" style="height: 300px; background: url('/assets/images/bus.jpg') no-repeat center center/cover;">
    <div class="bg-overlay position-absolute bg-black opacity-75 start-0 top-0 w-100 h-100"></div>
    <div class="container mx-auto position-relative z-1 h-100">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div>
                <h2 class="text-center text-white">BLOG</h2>
                <ul class="d-flex justify-content-center gap-1 list-unstyled">
                    <li><a href="/" class="text-white fs-6 fw-light font-secondary text-decoration-none">Home</a></li>
                    <li><span class="color-primary text-white mx-2"><i class="fa-solid fa-angle-right"></i></span></li>
                    <li><a href="/blogs" class="text-white fs-6 fw-light font-secondary text-decoration-none">Blog List</a></li>
                    <li><span class="color-primary text-white mx-2"><i class="fa-solid fa-angle-right"></i></span></li>
                    <li><span class="text-white fs-6 fw-light font-secondary">Blog Detail</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="our-blog">
    <div class="container">
        <div class="row">
            <!-- Blog Post Column -->
            <div class="col-lg-8 col-md-8">
                <!-- Loading indicator -->
                <div class="text-center py-5" id="loadingBlog" style="display: block;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">Loading blog...</p>
                </div>

                <!-- Blog Post Container -->
                <div id="blogDetailContainer" style="display: none;">
                    <!-- Blog detail will be loaded here -->
                </div>

                <!-- Error Container -->
                <div id="errorContainer" class="text-center py-5" style="display: none;">
                    <i class="fa-solid fa-exclamation-circle fa-3x text-danger mb-3"></i>
                    <h4>Blog not found</h4>
                    <p class="text-muted">The blog post you are looking for does not exist.</p>
                    <a href="/blogs" class="btn btn-primary mt-3">Back to Blog List</a>
                </div>
            </div>

            <!-- Sidebar -->
            @await Html.PartialAsync("_BlogSidebar")
        </div>
    </div>
</section>

<!-- Include shared sidebar script -->
<script src="~/js/blog-sidebar.js"></script>

<script>
    const blogId = @(blogId ?? "null");

    document.addEventListener('DOMContentLoaded', function () {
        if (blogId) {
            loadBlogDetail(blogId);
            loadSidebarData(); // From blog-sidebar.js
        } else {
            showError();
        }
    });

    async function loadBlogDetail(id) {
        try {
            const response = await fetch(`/blogs/api/detail/${id}`);
            
            if (response.ok) {
                const blog = await response.json();
                renderBlogDetail(blog);
                showBlogDetail();
            } else {
                showError();
            }
        } catch (error) {
            console.error('Error loading blog:', error);
            showError();
        }
    }

    function renderBlogDetail(blog) {
        const container = document.getElementById('blogDetailContainer');
        const hasImage = blog.imageUrl && blog.imageUrl.trim() !== '';

        container.innerHTML = `
            <article class="blog-detail-card">
                ${hasImage ? `
                <div class="blog-header-image">
                    <img src="${blog.imageUrl}" alt="${escapeHtml(blog.title)}" />
                </div>
                ` : ''}

                <div class="blog-meta">
                    <span class="category-badge">${escapeHtml(blog.categoryName)}</span>
                    <span class="separator">•</span>
                    <span class="author-name">
                        <i class="fa-solid fa-user"></i> ${escapeHtml(blog.authorName)}
                    </span>
                    <span class="separator">•</span>
                    <span class="blog-date">
                        <i class="fa-solid fa-calendar"></i> ${formatDate(blog.createdAt)}
                    </span>
                </div>

                <h1 class="blog-title">${escapeHtml(blog.title)}</h1>

                <div class="blog-content">
                    ${blog.content}
                </div>
            </article>
        `;
    }

    function showBlogDetail() {
        document.getElementById('loadingBlog').style.display = 'none';
        document.getElementById('blogDetailContainer').style.display = 'block';
        document.getElementById('errorContainer').style.display = 'none';
    }

    function showError() {
        document.getElementById('loadingBlog').style.display = 'none';
        document.getElementById('blogDetailContainer').style.display = 'none';
        document.getElementById('errorContainer').style.display = 'block';
    }

    function formatDate(dateString) {
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric'
        });
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>

