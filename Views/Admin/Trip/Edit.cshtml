@model Public_Transport.Models.Entities.Trip

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Update Trip";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4>Update Trip #@Model.TripId</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="TripId" />

                    <div class="mb-3">
                        <label class="form-label">Route</label>
                        <select asp-for="RouteId" class="form-control" asp-items="ViewBag.RouteId"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Vehicle</label>
                        <select asp-for="VehicleId" class="form-control" asp-items="ViewBag.VehicleId"></select>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="DepartureTime" class="form-label">Departure Time</label>
                            <input asp-for="DepartureTime" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ArrivalTime" class="form-label">Arrival Time</label>
                            <input asp-for="ArrivalTime" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-control">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Running">Running</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary">Back</a>
                        <button type="submit" class="btn btn-warning text-white">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>