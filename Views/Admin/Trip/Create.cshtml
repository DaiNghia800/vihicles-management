@model Public_Transport.Models.Entities.Trip

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Create Trip";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa-solid fa-plus-circle me-2"></i>Create New Trip</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="mainForm" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert" style="display:none"></div>
                    <select asp-for="RouteId" class="form-select select2" asp-items="ViewBag.RouteId">
                        <option value="">-- Type to search Route --</option>
                    </select>
                    @* <div class="mb-3">
                        <label asp-for="RouteId" class="form-label fw-bold">Select Route <span class="text-danger">*</span></label>
                        <select asp-for="RouteId" class="form-select" asp-items="ViewBag.RouteId">
                            <option value="">-- Choose a Route --</option>
                        </select>
                        <span asp-validation-for="RouteId" class="text-danger"></span>
                    </div> *@
                    <div class="row mb-4 align-items-center">
                        <label for="desc" class="col-3 form-label-title">Images</label>
                        <div class="col-9">
                            <div id="my-dropzone" class="dropzone"></div>
                            <input type="hidden" name="Thumbnail" id="Thumbnail">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="VehicleId" class="form-label fw-bold">Vehicle</label>
                            <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                                <option value="">-- Choose Vehicle --</option>
                            </select>
                            <span asp-validation-for="VehicleId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DriverId" class="form-label fw-bold">Driver</label>
                            <select asp-for="DriverId" class="form-select" asp-items="ViewBag.DriverId">
                                <option value="">-- Choose Driver --</option>
                            </select>
                            <span asp-validation-for="DriverId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="DepartureTime" class="form-label fw-bold">Departure Time <span class="text-danger">*</span></label>
                            <input asp-for="DepartureTime" class="form-control" type="datetime-local"
                                   value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="DepartureTime" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ArrivalTime" class="form-label fw-bold">Est. Arrival Time <span class="text-danger">*</span></label>
                            <input asp-for="ArrivalTime" class="form-control" type="datetime-local"
                                   value="@DateTime.Now.AddHours(1).ToString("yyyy-MM-ddTHH:mm")" />
                            <span asp-validation-for="ArrivalTime" class="text-danger"></span>
                        </div>
                    </div>

                    @* <div class="mb-4">
                        <label asp-for="Status" class="form-label fw-bold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Scheduled">Scheduled</option>
                            <option value="Running">Running</option>
                            <option value="Completed">Completed</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div> *@

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4" button-save><i class="fa-solid fa-save me-2"></i>Save Trip</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Script nhỏ để hiển thị alert nếu có lỗi
        $(document).ready(function() {
            if ($(".validation-summary-errors ul li").length > 0) {
                $(".alert-danger").show();
            }
        });
        $(document).ready(function() {
            $('.select2').select2({
                placeholder: "Searching for routes...",
                allowClear: true,
                width: '100%' // Fix lỗi hiển thị co cụm
            });
        });
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}