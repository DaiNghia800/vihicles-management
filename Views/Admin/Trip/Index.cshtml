@model IEnumerable<Public_Transport.Models.Entities.Trip>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Trip Management";
}

<div class="card card-hover">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Trip List</h4>
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>Create New Trip</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Route</th>
                        <th>Vehicle</th>
                        <th>Departure</th>
                        <th>Arrival (Est.)</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.TripId</td>
                            <td>
                                <strong>@item.Route.RouteName</strong>
                            </td>
                            <td>
                                <span class="badge bg-info text-dark">@item.Vehicle?.LicensePlate</span>
                            </td>
                            <td>@item.DepartureTime.ToString("dd/MM HH:mm")</td>
                            <td>@item.ArrivalTime.ToString("dd/MM HH:mm")</td>
                            <td>
                                @if (item.Status == "Scheduled")
                                {
                                    <span class="badge bg-warning">Scheduled</span>
                                }
                                else if (item.Status == "Running")
                                {
                                    <span class="badge bg-primary">Running</span>
                                }
                                else if (item.Status == "Completed")
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.TripId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.TripId" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>