@model Public_Transport.Models.Entities.Station

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Edit Station";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Edit Station: @Model.StationName</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="StationId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="StationName" class="form-label fw-bold">Station Name</label>
                        <input asp-for="StationName" class="form-control" />
                        <span asp-validation-for="StationName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-bold">Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Latitude" class="form-label fw-bold">Latitude</label>
                            <input asp-for="Latitude" class="form-control" type="number" step="any" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Longitude" class="form-label fw-bold">Longitude</label>
                            <input asp-for="Longitude" class="form-control" type="number" step="any" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-secondary px-4">Back</a>
                        <button type="submit" class="btn btn-warning px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}