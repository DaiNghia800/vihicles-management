@model IEnumerable<Public_Transport.Models.Entities.Station>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Station Management";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-primary fw-bold"><i class="fa-solid fa-location-dot me-2"></i>Station List</h5>
        @if (User.HasClaim("permission", "station_create"))
        {
            <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                <i class="fa-solid fa-plus me-1"></i> Add New Station
            </a>
        }
    </div>

    @if (ViewData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="fa-solid fa-circle-exclamation me-2"></i> @ViewData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Station Name</th>
                        <th>Address</th>
                        <th>Coordinates (Lat, Long)</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.StationName</td>
                            <td>@item.Address</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.Latitude, @item.Longitude
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                @if (User.HasClaim("permission", "station_edit"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.StationId" class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                }
                                @if (User.HasClaim("permission", "station_delete"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.StationId" class="btn btn-sm btn-outline-danger" title="Delete">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>
                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>