@using System.Text.Json
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Dashboard";
}

<section class="dashboard-area">
    <div class="row">
        <div class="col-sm-6 col-xxl-3 col-lg-6">
            <div class="box-total card-hover">
                <div class="box-contain">
                    <div class="media-body">
                        <span>Total Revenue</span>
                        <h4>
                            @* @Model.TotalRevenue.ToString("N0") VND *@
                            <span class="font-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trending-up"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
                                +10%
                            </span>
                        </h4>
                    </div>
                    <div class="box-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-database"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-3 col-lg-6">
            <div class="box-total box-order card-hover">
                <div class="box-contain">
                    <div class="media-body">
                        <span>Total Orders</span>
                        <h4>
                            @* @Model.TotalOrders *@
                            <span class="font-danger">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trending-down"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
                                -5%
                            </span>
                        </h4>
                    </div>
                    <div class="box-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-bag"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-3 col-lg-6">
            <div class="box-total box-product card-hover">
                <div class="box-contain">
                    <div class="media-body">
                        <span>Total Products</span>
                        <h4>
                            @* @Model.TotalProducts *@
                            <span>
                                Add new
                            </span>
                        </h4>
                    </div>
                    <div class="box-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-message-circle"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xxl-3 col-lg-6">
            <div class="box-total box-custom card-hover">
                <div class="box-contain">
                    <div class="media-body">
                        <span>Total Customers</span>
                        <h4>
                            @* @Model.TotalCustomers *@
                            <span class="font-success">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-trending-down"><polyline points="23 18 13.5 8.5 8.5 13.5 1 6"></polyline><polyline points="17 18 23 18 23 12"></polyline></svg>
                                +15%
                            </span>
                        </h4>
                    </div>
                    <div class="box-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12">
            <div class="box-category card-hover">
                <div class="box-title mb-3">
                    <h4 class="text-capitalize">Categories</h4>
                </div>
                @* <div class="slide-dashboard-category">
                    @if (Model.Categories != null)
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            <div>
                                <a href="#" class="category-img">
                                    @{
                                        // 1. Giải mã JSON từ cột Thumbnail
                                        var thumbnails = string.IsNullOrWhiteSpace(cat.Thumbnail)
                                        ? new List<string>()
                                        : JsonSerializer.Deserialize<List<string>>(cat.Thumbnail);

                                        // 2. Lấy ảnh đầu tiên trong list
                                        var firstImg = thumbnails != null ? thumbnails.FirstOrDefault() : null;

                                        // 3. Kiểm tra nếu có ảnh thì dùng, không thì dùng ảnh mặc định
                                        var displayImg = !string.IsNullOrEmpty(firstImg) ? firstImg : "/images/placeholder.png";
                                    }

                                    <img src="@displayImg" alt="@cat.CategoryName" class="img-fluid" style="width:50px; height:50px; object-fit:contain;" />
                                </a>
                                <a href="#" class="category-name">
                                    <h6>@cat.CategoryName</h6>
                                </a>
                            </div>
                        }
                    }
                </div> *@
            </div>
        </div>

        <div class="col-6">
            <div class="box-report card-hover">
                <div class="box-title mb-3">
                    <h4 class="text-capitalize">Revenue Report</h4>
                </div>
                <div id="report-chart"></div>
            </div>
        </div>

        <div class="col-6">
            <div class="box-best-selling card-hover">
                <div class="box-title-border">
                    <div class="title">
                        <h4>Recent Orders</h4>
                    </div>
                </div>
                @* <div class="table-responsive">
                    <table class="best-selling-table table mb-0">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Payment</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentOrders != null)
                            {
                                foreach (var order in Model.RecentOrders)
                                {
                                    <tr>
                                        <td>
                                            <div class="product-detail-box">
                                                <h6>#@order.Uid</h6>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="product-detail-box">
                                                <h6>@order.OrderDate.ToString("dd/MM/yyyy")</h6>
                                                <h5>@order.OrderDate.ToString("HH:mm")</h5>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="product-detail-box">
                                                <h5 style="color: #0da487;">@order.TotalAmount.ToString("#,##0") VND</h5>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="product-detail-box">
                                                @if (order.Status == "Completed" || order.Status == "Delivered")
                                                {
                                                    <h5 class="text-success">@order.Status</h5>
                                                }
                                                else if (order.Status == "Cancelled")
                                                {
                                                    <h5 class="text-danger">@order.Status</h5>
                                                }
                                                else
                                                {
                                                    <h5 class="text-warning">@order.Status</h5>
                                                }
                                            </div>
                                        </td>
                                        <td>
                                            <div class="product-detail-box">
                                                <h6>@order.PaymentMethod</h6>
                                                @if (order.Status == "Paid" || order.Status == "Completed")
                                                {
                                                    <h5 class="text-success">Paid</h5>
                                                }
                                                else
                                                {
                                                    <h5 class="text-danger">Unpaid</h5>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div> *@
            </div>
        </div>

        <div class="col-12">
            <div class="box-earning card-hover">
                <div class="box-title mb-3">
                    <h4 class="text-capitalize">Earning</h4>
                </div>
                <div id="earning-chart"></div>
            </div>
        </div>

        @* <div class="col-6">
            <div class="box-to-do card-hover">
                <div class="box-title mb-3">
                    <h4 class="text-capitalize">To Do List</h4>
                </div>
                <ul class="to-do-list">
                    <li>
                        <div class="form-check ps-0">
                            <input type="checkbox" class="check-animated" />
                        </div>
                        <div class="to-do-list-name">
                            <strong>Check new orders</strong>
                            <p>Daily</p>
                        </div>
                    </li>
                    <li>
                        <div class="form-check ps-0">
                            <input type="checkbox" class="check-animated" />
                        </div>
                        <div class="to-do-list-name">
                            <strong>Update product stock</strong>
                            <p>Weekly</p>
                        </div>
                    </li>
                </ul>
            </div>
        </div> *@
    </div>
</section>
