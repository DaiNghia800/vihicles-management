@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Blog Categories Management";
}

<!-- Thêm anti-forgery token -->
@Html.AntiForgeryToken()

<style>
    .category-management {
        padding: 1.25rem;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.875rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 0.9375rem;
        align-items: center;
    }

    .search-box {
        position: relative;
    }

        .search-box input {
            padding: 0.625rem 2.5rem 0.625rem 0.9375rem;
            border: 0.0625rem solid #ddd;
            border-radius: 0.5rem;
            width: 18.75rem;
            font-size: 0.875rem;
            transition: all 0.3s;
        }

            .search-box input:focus {
                outline: none;
                border-color: #14a38b;
                box-shadow: 0 0 0 0.1875rem rgba(20, 163, 139, 0.1);
            }

    .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background-color: #14a38b;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0f8570;
            transform: translateY(-0.0625rem);
            box-shadow: 0 0.25rem 0.75rem rgba(20, 163, 139, 0.3);
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .table-card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
    }

        .category-table thead {
            background-color: #f8f9fa;
        }

        .category-table th {
            padding: 0.9375rem;
            text-align: left;
            font-weight: 600;
            color: #000000;
            border-bottom: 0.125rem solid #dee2e6;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.03125rem;
        }

        .category-table td {
            padding: 0.9375rem;
            border-bottom: 0.0625rem solid #f0f0f0;
            vertical-align: middle;
        }

        .category-table tbody tr {
            transition: all 0.3s;
        }

            .category-table tbody tr:hover {
                background-color: #f8f9fa;
            }

    .category-name {
        font-weight: 500;
        color: #333;
        font-size: 0.9375rem;
    }

    .blog-count-badge {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        background-color: #e3f2fd;
        color: #1976d2;
        border-radius: 1rem;
        font-size: 0.8125rem;
        font-weight: 500;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
    }

    .action-icon {
        display: inline-block;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0.5rem;
        border: none;
        border-radius: 50%;
        background-color: transparent;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease-in-out;
    }

        .action-icon svg {
            width: 100%;
            height: 100%;
        }

    .icon-edit {
        color: #4aa4d9;
    }

        .icon-edit:hover {
            background-color: rgba(74, 164, 217, 0.1);
        }

    .icon-delete {
        color: #dc3545;
    }

        .icon-delete:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }

    .no-data {
        text-align: center;
        padding: 3.75rem 1.25rem;
        color: #999;
    }

    .no-data-icon {
        font-size: 4rem;
        margin-bottom: 1.25rem;
        opacity: 0.3;
    }

    .no-data-text {
        font-size: 1.125rem;
        font-weight: 500;
        margin-bottom: 0.625rem;
    }

    .loading {
        text-align: center;
        padding: 2.5rem;
        color: #14a38b;
    }

    .spinner {
        border: 0.1875rem solid #f3f3f3;
        border-top: 0.1875rem solid #14a38b;
        border-radius: 50%;
        width: 2.5rem;
        height: 2.5rem;
        animation: spin 1s linear infinite;
        margin: 0 auto 0.9375rem;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Modal Styles */
    .modal-header {
        background-color: #14a38b;
        color: white;
        border-bottom: none;
    }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

    .form-label {
        font-weight: 500;
        color: #333;
        margin-bottom: 0.5rem;
    }

    .required {
        color: #dc3545;
        margin-left: 0.25rem;
    }

    .form-control:focus {
        border-color: #14a38b;
        box-shadow: 0 0 0 0.2rem rgba(20, 163, 139, 0.25);
    }

    /* Pagination Styles */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
        border-top: 1px solid #f0f0f0;
    }

    .pagination-info {
        color: #666;
        font-size: 0.875rem;
    }

    .pagination {
        display: flex;
        gap: 0.5rem;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .page-item {
        display: inline-block;
    }

    .page-link {
        padding: 0.5rem 0.75rem;
        border: 1px solid #ddd;
        border-radius: 0.375rem;
        color: #333;
        text-decoration: none;
        transition: all 0.3s;
        cursor: pointer;
    }

        .page-link:hover {
            background-color: #f8f9fa;
            border-color: #14a38b;
            color: #14a38b;
        }

    .page-item.active .page-link {
        background-color: #14a38b;
        border-color: #14a38b;
        color: white;
    }

    .page-item.disabled .page-link {
        opacity: 0.5;
        cursor: not-allowed;
        pointer-events: none;
    }
</style>

<div class="category-management">
    <div class="header-section">
        <h1 class="page-title">Blog Categories Management</h1>
        <div class="header-actions">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Search categories..." />
            </div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="openAddModal()">
                Add New 
            </button>
        </div>
    </div>

    <div class="table-card">
        <div id="loadingIndicator" class="loading" style="display: none;">
            <div class="spinner"></div>
            <p>Loading categories...</p>
        </div>

        <table class="category-table" id="categoryTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Blog Posts Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="categoryTableBody">
                <!-- Data will be loaded here -->
            </tbody>
        </table>

        <!-- Pagination -->
        <div class="pagination-container" id="paginationContainer" style="display: none;">
            <div class="pagination-info" id="paginationInfo"></div>
            <ul class="pagination" id="pagination"></ul>
        </div>
    </div>
</div>

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryId" value="">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">
                            Category Name <span class="required">*</span>
                        </label>
                        <input type="text" class="form-control" id="categoryName" placeholder="Enter category name" required>
                        <div class="invalid-feedback">
                            Please enter a category name.
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-procces btn-animate" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Save Category</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    let categories = [];
    let blogCounts = {};
    let filteredCategories = [];

    // Pagination variables
    const itemsPerPage = 5;
    let currentPage = 1;

    // Lấy anti-forgery token
    function getAntiForgeryToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    }

    document.addEventListener('DOMContentLoaded', function () {
        console.log('=== Page loaded ===');
        loadCategories();
        setupSearch();
    });

    async function loadCategories() {
        showLoading(true);
        try {
            console.log('Loading categories...');
            const response = await fetch('/api/BlogCategories');
            console.log('Response status:', response.status);

            if (response.ok) {
                categories = await response.json();
                console.log('Categories loaded:', categories.length);
                await loadBlogCounts();
                filteredCategories = [...categories];
                renderTable();
                updatePagination();
            } else {
                const errorText = await response.text();
                console.error('Error response:', errorText);
                showNoData();
            }
        } catch (error) {
            console.error('Error loading categories:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Failed to load categories: ' + error.message
            });
        } finally {
            showLoading(false);
        }
    }

    async function loadBlogCounts() {
        try {
            const response = await fetch('/admin/blog/api/list');
            if (response.ok) {
                const blogs = await response.json();
                blogCounts = {};
                blogs.forEach(blog => {
                    blogCounts[blog.categoryUid] = (blogCounts[blog.categoryUid] || 0) + 1;
                });
                console.log('Blog counts loaded:', blogCounts);
            }
        } catch (error) {
            console.error('Error loading blog counts:', error);
        }
    }

    function setupSearch() {
        document.getElementById('searchInput').addEventListener('input', function (e) {
            const searchTerm = e.target.value.toLowerCase();
            filteredCategories = categories.filter(category =>
                category.name.toLowerCase().includes(searchTerm) ||
                category.uid.toString().includes(searchTerm)
            );
            currentPage = 1;
            renderTable();
            updatePagination();
        });
    }

    function renderTable() {
        const tbody = document.getElementById('categoryTableBody');

        if (filteredCategories.length === 0) {
            showNoData();
            document.getElementById('paginationContainer').style.display = 'none';
            return;
        }

        // Calculate pagination
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const paginatedCategories = filteredCategories.slice(startIndex, endIndex);

        tbody.innerHTML = paginatedCategories.map(category => `
            <tr>
                <td>${category.uid}</td>
                <td>
                    <span class="category-name">${category.name}</span>
                </td>
                <td>
                    <span class="blog-count-badge">${blogCounts[category.uid] || 0} blogs</span>
                </td>
                <td>
                    <div class="action-buttons">
                        <button type="button" class="action-icon icon-edit" onclick="openEditModal(${category.uid})" title="Edit Category">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M15.7279 9.57627L14.3137 8.16206L5 17.4758V18.89H6.41421L15.7279 9.57627ZM17.1421 8.16206L18.5563 6.74785L17.1421 5.33363L15.7279 6.74785L17.1421 8.16206ZM7.24264 20.89H3V16.6473L16.435 3.21231C16.8256 2.82179 17.4587 2.82179 17.8492 3.21231L20.6777 6.04074C21.0682 6.43126 21.0682 7.06443 20.6777 7.45495L7.24264 20.89Z"></path>
                            </svg>
                        </button>
                        <button type="button" class="action-icon icon-delete" onclick="deleteCategory(${category.uid})" title="Delete Category">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"></path>
                            </svg>
                        </button>
                    </div>
                </td>
            </tr>
        `).join('');

        document.getElementById('paginationContainer').style.display = 'flex';
    }

    function updatePagination() {
        const totalPages = Math.ceil(filteredCategories.length / itemsPerPage);
        const paginationElement = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        // Update info
        const startItem = (currentPage - 1) * itemsPerPage + 1;
        const endItem = Math.min(currentPage * itemsPerPage, filteredCategories.length);
        paginationInfo.textContent = `Showing ${startItem} to ${endItem} of ${filteredCategories.length} categories`;

        // Build pagination
        let paginationHTML = '';

        // Previous button
        paginationHTML += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <a class="page-link" onclick="changePage(${currentPage - 1})">Previous</a>
            </li>
        `;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (
                i === 1 ||
                i === totalPages ||
                (i >= currentPage - 2 && i <= currentPage + 2)
            ) {
                paginationHTML += `
                    <li class="page-item ${i === currentPage ? 'active' : ''}">
                        <a class="page-link" onclick="changePage(${i})">${i}</a>
                    </li>
                `;
            } else if (i === currentPage - 3 || i === currentPage + 3) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        paginationHTML += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <a class="page-link" onclick="changePage(${currentPage + 1})">Next</a>
            </li>
        `;

        paginationElement.innerHTML = paginationHTML;
    }

    function changePage(page) {
        const totalPages = Math.ceil(filteredCategories.length / itemsPerPage);
        if (page < 1 || page > totalPages) return;

        currentPage = page;
        renderTable();
        updatePagination();

        // Scroll to top of table
        document.getElementById('categoryTable').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function showNoData() {
        const tbody = document.getElementById('categoryTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="4" class="no-data">
                    <div class="no-data-icon">📁</div>
                    <div class="no-data-text">No categories found</div>
                    <p>Start by creating your first blog category!</p>
                </td>
            </tr>
        `;
    }

    function showLoading(show) {
        document.getElementById('loadingIndicator').style.display = show ? 'block' : 'none';
        document.getElementById('categoryTable').style.display = show ? 'none' : 'table';
        document.getElementById('paginationContainer').style.display = show ? 'none' : 'flex';
    }

    function openAddModal() {
        document.getElementById('categoryModalLabel').textContent = 'Add New Category';
        document.getElementById('categoryForm').reset();
        document.getElementById('categoryId').value = '';
        document.getElementById('categoryName').classList.remove('is-invalid');
    }

    function openEditModal(categoryId) {
        const category = categories.find(c => c.uid === categoryId);
        if (!category) return;

        document.getElementById('categoryModalLabel').textContent = 'Edit Category';
        document.getElementById('categoryId').value = category.uid;
        document.getElementById('categoryName').value = category.name;
        document.getElementById('categoryName').classList.remove('is-invalid');

        const modal = new bootstrap.Modal(document.getElementById('categoryModal'));
        modal.show();
    }

    async function saveCategory() {
        const categoryId = document.getElementById('categoryId').value;
        const categoryName = document.getElementById('categoryName').value.trim();
        const categoryNameInput = document.getElementById('categoryName');

        // Validation
        if (!categoryName) {
            categoryNameInput.classList.add('is-invalid');
            Swal.fire({
                icon: 'warning',
                title: 'Validation Error',
                text: 'Please enter a category name'
            });
            return;
        }

        categoryNameInput.classList.remove('is-invalid');

        const data = {
            name: categoryName
        };

        console.log('Saving category:', data);
        console.log('Category ID:', categoryId);

        try {
            let url, method;
            if (categoryId) {
                url = `/api/BlogCategories/${categoryId}`;
                method = 'PUT';
            } else {
                url = '/api/BlogCategories';
                method = 'POST';
            }

            console.log('Request:', method, url);
            console.log('Payload:', JSON.stringify(data));

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json'
                    // BỎ RequestVerificationToken - không cần cho API với [Authorize]
                },
                body: JSON.stringify(data)
            });

            console.log('Response status:', response.status);

            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: categoryId ? 'Category updated successfully!' : 'Category created successfully!',
                    timer: 1500,
                    showConfirmButton: false
                });

                bootstrap.Modal.getInstance(document.getElementById('categoryModal')).hide();
                await loadCategories();
            } else {
                const errorText = await response.text();
                console.error('Error response:', errorText);

                let errorMessage = 'Failed to save category';
                try {
                    const error = JSON.parse(errorText);
                    errorMessage = error.message || errorMessage;
                } catch (e) {
                    errorMessage = errorText || errorMessage;
                }

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: errorMessage
                });
            }
        } catch (error) {
            console.error('Error saving category:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while saving: ' + error.message
            });
        }
    }

    async function deleteCategory(categoryId) {
        const blogCount = blogCounts[categoryId] || 0;

        if (blogCount > 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Cannot Delete Category',
                text: `This category is being used by ${blogCount} blog post(s). Please reassign or delete those posts first.`,
                confirmButtonText: 'OK',
                confirmButtonColor: '#14a38b'
            });
            return;
        }

        const result = await Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'Cancel'
        });

        if (!result.isConfirmed) return;

        try {
            const token = getAntiForgeryToken();
            const headers = {};

            // Thêm anti-forgery token nếu có
            if (token) {
                headers['RequestVerificationToken'] = token;
            }

            const response = await fetch(`/api/BlogCategories/${categoryId}`, {
                method: 'DELETE',
                headers: headers
            });

            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Category has been deleted.',
                    timer: 1500,
                    showConfirmButton: false
                });
                await loadCategories();
            } else {
                const errorText = await response.text();
                console.error('Error response:', errorText);

                let errorMessage = 'Failed to delete category';
                try {
                    const error = JSON.parse(errorText);
                    errorMessage = error.message || errorMessage;
                } catch (e) {
                    errorMessage = errorText || errorMessage;
                }

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: errorMessage
                });
            }
        } catch (error) {
            console.error('Error deleting category:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'An error occurred while deleting: ' + error.message
            });
        }
    }
</script>