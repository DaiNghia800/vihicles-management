
@model Public_Transport.Models.Entities.Users
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Create New User";
}

<section class="user-area">
    <div class="card">
        <div class="card-header2">
            <h5>Create New User</h5>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="theme-form">
            @Html.AntiForgeryToken()

            <div class="row">
                <!-- ✅ THÊM: Upload Avatar Section -->
                <div class="col-12 mb-4">
                    <div class="card">
                        <div class="card-body text-center">
                            <h6 class="mb-3">User Avatar</h6>
                            <div class="avatar-upload-container mb-3">
                                <img id="avatarPreview"
                                     src="https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png"
                                     alt="Avatar Preview"
                                     class="rounded-circle"
                                     style="width: 150px; height: 150px; object-fit: cover; border: 3px solid #f0f0f0;">
                            </div>
                            <div class="form-group">
                                <label for="avatarUpload" class="btn btn-primary btn-sm">
                                    <i class="fa fa-upload me-2"></i>Choose Avatar
                                </label>
                                <input type="file"
                                       id="avatarUpload"
                                       name="AvatarFile"
                                       accept="image/*"
                                       class="d-none">
                                <small class="form-text text-muted d-block mt-2">
                                    Max file size: 5MB. Accepted formats: JPG, PNG, GIF
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Full Name -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                        <label asp-for="FullName" class="form-label-title">Full Name <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <!-- Email -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" placeholder="Email" type="email" />
                        <label asp-for="Email" class="form-label-title">Email <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <!-- Phone Number -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="PhoneNumber" class="form-control" placeholder="Phone Number" />
                        <label asp-for="PhoneNumber" class="form-label-title">Phone Number <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <!-- Date of Birth -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <label asp-for="DateOfBirth" class="form-label-title">Date of Birth <span class="text-danger">*</span></label>
                    </div>
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>

                <!-- Address -->
                <div class="col-12 mb-3">
                    <div class="form-floating">
                        <input asp-for="Address" class="form-control" placeholder="Address" />
                        <label asp-for="Address" class="form-label-title">Address</label>
                    </div>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <!-- ✅ FIX: Role - Đổi từ ViewBag.RoleList thành ViewBag.Roles -->
                <div class="col-md-6 mb-3">
                    <label class="form-label-title">Role <span class="text-danger">*</span></label>
                    <select asp-for="RoleUid" class="form-control js-example-basic-single">
                        <option value="">-- Select Role --</option>
                        @if (ViewBag.Roles != null)
                        {
                            @foreach (var role in ViewBag.Roles)
                            {
                                <option value="@role.Uid">@role.RoleName</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="RoleUid" class="text-danger"></span>
                </div>

                <!-- Password -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input type="password" name="Password" class="form-control" placeholder="Password" />
                        <label class="form-label-title">Password <span class="text-danger">*</span></label>
                    </div>
                    <span class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="col-md-6 mb-3">
                    <div class="form-floating">
                        <input type="password" name="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                        <label class="form-label-title">Confirm Password <span class="text-danger">*</span></label>
                    </div>
                    <span class="text-danger"></span>
                </div>
            </div>

            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">
                    <i class="fa fa-times me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa fa-save me-2"></i>Create User
                </button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // ✅ Avatar Upload Preview
        $(document).ready(function() {
            $('#avatarUpload').on('change', function(e) {
                const file = e.target.files[0];

                if (file) {
                    // Validate file size (5MB max)
                    if (file.size > 5 * 1024 * 1024) {
                        Swal.fire({
                            icon: 'error',
                            title: 'File Too Large',
                            text: 'Avatar file must be less than 5MB'
                        });
                        $(this).val('');
                        return;
                    }

                    // Validate file type
                    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(file.type)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Invalid File Type',
                            text: 'Only JPG, PNG, and GIF images are allowed'
                        });
                        $(this).val('');
                        return;
                    }

                    // Preview image
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#avatarPreview').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(file);
                }
            });

            // Phone number validation
            $('input[name="PhoneNumber"]').on('input', function() {
                let value = $(this).val();
                value = value.replace(/[^0-9]/g, '');
                if (value.length > 10) {
                    value = value.substring(0, 10);
                }
                $(this).val(value);
            });
        });
    </script>
}