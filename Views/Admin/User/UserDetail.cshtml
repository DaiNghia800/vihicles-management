@using Public_Transport.Models.Entities
@using System.Text.Json
<div class="row">
    <div class="col-md-4 text-center border-end">
        @{
            Users users = Model;
            var thumbnails = string.IsNullOrWhiteSpace(users.ImgUser)
            ? new List<string>()
            : JsonSerializer.Deserialize<List<string>>(users.ImgUser);

            var firstImg = thumbnails.FirstOrDefault();
        }

        @if (!string.IsNullOrEmpty(firstImg))
        {
            <img src=@firstImg alt=@users.FullName class="img-fluid rounded-circle mb-3"
                 style="width: 150px; height: 150px; object-fit: cover;  " />
        }
        <h5 class="mb-1">@Model.FullName</h5>
        <p class="text-muted mb-0">@Model.Role.RoleName</p>
    </div>

    <div class="col-md-8">
        <div class="user-detail-info px-3">

            <h6 class="text-primary fw-bold mb-3 pt-2">Contact information</h6>
            <div class="mb-3">
                <label class="fw-bold d-block">Email:</label>
                <span class="text-muted">@Model.Email</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold d-block">Phone number:</label>
                <span class="text-muted">@Model.PhoneNumber</span>
            </div>
            <div class="mb-3">
                <label class="fw-bold d-block">Address:</label>
                <span class="text-muted">@Model.Address</span>
            </div>

            <hr>

            <h6 class="text-primary fw-bold mb-3">System information</h6>
            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label class="fw-bold d-block">Creation date:</label>
                    <span class="text-muted">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label class="fw-bold d-block">Created by:</label>
                    <span class="text-muted">
                        @(string.IsNullOrEmpty(Model.CreatedBy) ? "N/A" : Model.CreatedBy)
                    </span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label class="fw-bold d-block">Updated (last):</label>
                    <span class="text-muted">
                        @(Model.UpdatedAt == Model.CreatedAt ? "Not updated yet" : Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm"))
                    </span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label class="fw-bold d-block">Updated (by):</label>
                    <span class="text-muted">
                        @(string.IsNullOrEmpty(Model.UpdatedBy) ? "N/A" : Model.UpdatedBy)
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>