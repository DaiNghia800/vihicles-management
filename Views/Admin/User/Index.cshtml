@using System.Text.Json

@model IEnumerable<Public_Transport.Models.Entities.Users>
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "User Management";
    var roles = ViewBag.Roles as IEnumerable<Public_Transport.Models.Entities.Roles>;
}

<style>
    .user-management {
        padding: 1.25rem;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.875rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 0.9375rem;
        align-items: center;
    }

    .search-filter-section {
        background: white;
        padding: 1.25rem;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
        margin-bottom: 1.5rem;
    }

    .filter-row {
        display: grid;
        grid-template-columns: 2fr 1fr auto;
        gap: 1rem;
        align-items: end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

        .filter-group label {
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #333;
            font-size: 0.875rem;
        }

    .form-input,
    .form-select {
        padding: 0.625rem 0.9375rem;
        border: 0.0625rem solid #ddd;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }

    .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background-color: #14a38b;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0f8570;
            transform: translateY(-0.0625rem);
            box-shadow: 0 0.25rem 0.75rem rgba(20, 163, 139, 0.3);
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .table-card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
    }

    .user-table {
        width: 100%;
        border-collapse: collapse;
    }

        .user-table thead {
            background-color: #f8f9fa;
        }

        .user-table th {
            padding: 0.9375rem;
            text-align: left;
            font-weight: 600;
            color: #000;
            border-bottom: 0.125rem solid #dee2e6;
            font-size: 0.875rem;
            text-transform: uppercase;
        }

        .user-table td {
            padding: 0.9375rem;
            border-bottom: 0.0625rem solid #f0f0f0;
            vertical-align: middle;
        }

        .user-table tbody tr:hover {
            background-color: #f8f9fa;
        }

    .user-avatar {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

        .user-info .user-details {
            display: flex;
            flex-direction: column;
        }

            .user-info .user-details .user-name {
                font-weight: 600;
                color: #333;
            }

            .user-info .user-details .user-email {
                font-size: 0.8125rem;
                color: #666;
            }

    .role-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
        display: inline-block;
    }

    .role-admin {
        background-color: #d4edda;
        color: #155724;
    }

    .role-staff {
        background-color: #cfe2ff;
        color: #084298;
    }

    .role-customer {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-active {
        background-color: #d4edda;
        color: #155724;
    }

    .status-inactive {
        background-color: #f8d7da;
        color: #721c24;
    }

    .action-icon {
        display: inline-block;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0.5rem;
        border: none;
        border-radius: 50%;
        background-color: transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

        .action-icon svg {
            width: 100%;
            height: 100%;
        }

    .icon-view {
        color: #747dc6;
    }

        .icon-view:hover {
            background-color: rgba(116, 125, 198, 0.1);
        }

    .icon-edit {
        color: #4aa4d9;
    }

        .icon-edit:hover {
            background-color: rgba(74, 164, 217, 0.1);
        }

    .icon-delete {
        color: #dc3545;
    }

        .icon-delete:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }

    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        padding: 1.25rem;
        border-top: 1px solid #dee2e6;
    }

        .pagination .page-btn {
            padding: 0.5rem 0.75rem;
            border: 1px solid #ddd;
            background: white;
            color: #333;
            border-radius: 0.375rem;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s;
        }

            .pagination .page-btn:hover {
                background-color: #14a38b;
                color: white;
                border-color: #14a38b;
            }

            .pagination .page-btn.active {
                background-color: #14a38b;
                color: white;
                border-color: #14a38b;
            }

            .pagination .page-btn:disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

        .pagination .page-info {
            color: #666;
            font-size: 0.875rem;
        }
</style>

<div class="user-management">
    <div class="header-section">
        <h1 class="page-title">User Management</h1>
        <div class="header-actions">
            <a href="/admin/user/create" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add New User
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search and Filter Section -->
    <div class="search-filter-section">
        <form method="get" action="/admin/user">
            <div class="filter-row">
                <div class="filter-group">
                    <label>Search</label>
                    <input type="text" 
                           name="searchTerm" 
                           class="form-input" 
                           placeholder="Search by name, email, phone..." 
                           value="@ViewBag.SearchTerm" />
                </div>
                <div class="filter-group">
                    <label>Role</label>
                    <select name="roleFilter" class="form-select">
                        <option value="">All Roles</option>
                        @if (roles != null)
                        {
                            @foreach (var role in roles)
                            {
                                <option value="@role.Uid" selected="@(ViewBag.RoleFilter == role.Uid)">
                                    @role.RoleName
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="filter-group">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-search"></i> Search
                    </button>
                </div>
            </div>
        </form>
    </div>

    <!-- Users Table -->
    <div class="table-card">
        <table class="user-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Phone</th>
                    <th>Address</th>
                    <th>Role</th>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        // ✅ FIX: Parse image URL correctly
                        var imageUrl = "https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png";
                        
                        if (!string.IsNullOrWhiteSpace(user.ImgUser))
                        {
                            try
                            {
                                // Kiểm tra nếu là URL trực tiếp
                                if (user.ImgUser.StartsWith("http"))
                                {
                                    imageUrl = user.ImgUser;
                                }
                                // Kiểm tra nếu là JSON array
                                else if (user.ImgUser.TrimStart().StartsWith("["))
                                {
                                    var images = JsonSerializer.Deserialize<List<string>>(user.ImgUser);
                                    imageUrl = images?.FirstOrDefault() ?? imageUrl;
                                }
                                else
                                {
                                    // Remove brackets and quotes nếu có
                                    imageUrl = user.ImgUser.Trim('[', ']', '"', ' ');
                                }
                            }
                            catch
                            {
                                // Use default if parsing fails
                                imageUrl = user.ImgUser.Trim('[', ']', '"', ' ');
                            }
                        }
                    
                        <tr>
                            <td>
                                <div class="user-info">
                                    <img src="@imageUrl" 
                                         alt="@user.FullName" 
                                         class="user-avatar"
                                         onerror="this.src='https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png'" />
                                    <div class="user-details">
                                        <span class="user-name">@user.FullName</span>
                                        <span class="user-email">@user.Email</span>
                                    </div>
                                </div>
                            </td>
                            <td>@user.PhoneNumber</td>
                            <td>@(string.IsNullOrEmpty(user.Address) ? "N/A" : user.Address)</td>
                            <td>
                                <span class="role-badge role-@(user.Role?.RoleName?.ToLower() ?? "unknown")">
                                    @(user.Role?.RoleName ?? "No Role")
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="status-badge status-@(user.Deleted ? "inactive" : "active")">
                                    @(user.Deleted ? "Inactive" : "Active")
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/admin/user/detail/@user.Uid" class="action-icon icon-view" title="View Details">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M12.0003 3C17.3924 3 21.8784 6.87976 22.8189 12C21.8784 17.1202 17.3924 21 12.0003 21C6.60812 21 2.12215 17.1202 1.18164 12C2.12215 6.87976 6.60812 3 12.0003 3ZM12.0003 19C16.2359 19 19.8603 16.052 20.7777 12C19.8603 7.94803 16.2359 5 12.0003 5C7.7646 5 4.14022 7.94803 3.22278 12C4.14022 16.052 7.7646 19 12.0003 19ZM12.0003 16.5C9.51498 16.5 7.50026 14.4853 7.50026 12C7.50026 9.51472 9.51498 7.5 12.0003 7.5C14.4855 7.5 16.5003 9.51472 16.5003 12C16.5003 14.4853 14.4855 16.5 12.0003 16.5ZM12.0003 14.5C13.381 14.5 14.5003 13.3807 14.5003 12C14.5003 10.6193 13.381 9.5 12.0003 9.5C10.6196 9.5 9.50026 10.6193 9.50026 12C9.50026 13.3807 10.6196 14.5 12.0003 14.5Z"></path></svg>
                                    </a>
                                    <a href="/admin/user/edit/@user.Uid" class="action-icon icon-edit" title="Edit User">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.7279 9.57627L14.3137 8.16206L5 17.4758V18.89H6.41421L15.7279 9.57627ZM17.1421 8.16206L18.5563 6.74785L17.1421 5.33363L15.7279 6.74785L17.1421 8.16206ZM7.24264 20.89H3V16.6473L16.435 3.21231C16.8256 2.82179 17.4587 2.82179 17.8492 3.21231L20.6777 6.04074C21.0682 6.43126 21.0682 7.06443 20.6777 7.45495L7.24264 20.89Z"></path></svg>
                                    </a>
                                    <form action="/admin/user/delete/@user.Uid" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-icon icon-delete" title="Delete User">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"></path></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <p>No users found.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Pagination -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="pagination">
                @if (ViewBag.CurrentPage > 1)
                {
                    <a href="?pageIndex=@(ViewBag.CurrentPage - 1)&searchTerm=@ViewBag.SearchTerm&roleFilter=@ViewBag.RoleFilter" class="page-btn">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>
                }

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a href="?pageIndex=@i&searchTerm=@ViewBag.SearchTerm&roleFilter=@ViewBag.RoleFilter" 
                       class="page-btn @(i == ViewBag.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }

                @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                {
                    <a href="?pageIndex=@(ViewBag.CurrentPage + 1)&searchTerm=@ViewBag.SearchTerm&roleFilter=@ViewBag.RoleFilter" class="page-btn">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                }

                <span class="page-info ms-3">
                    Showing page @ViewBag.CurrentPage of @ViewBag.TotalPages (@ViewBag.TotalUsers total users)
                </span>
            </div>
        }
    </div>
</div>