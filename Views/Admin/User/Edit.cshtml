@using System.Text.Json

@model Public_Transport.Models.Entities.Users
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Edit User";
    var roles = ViewBag.Roles as IEnumerable<Public_Transport.Models.Entities.Roles>;
    
    // ✅ FIX: Parse ảnh từ JSON
    var imageUrl = "https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png";
    
    if (!string.IsNullOrWhiteSpace(Model.ImgUser))
    {
        try
        {
            // Kiểm tra nếu là URL trực tiếp
            if (Model.ImgUser.StartsWith("http"))
            {
                imageUrl = Model.ImgUser;
            }
            // Kiểm tra nếu là JSON array
            else if (Model.ImgUser.TrimStart().StartsWith("["))
            {
                var images = JsonSerializer.Deserialize<List<string>>(Model.ImgUser);
                imageUrl = images?.FirstOrDefault() ?? imageUrl;
            }
            else
            {
                // Remove brackets and quotes nếu có
                imageUrl = Model.ImgUser.Trim('[', ']', '"', ' ');
            }
        }
        catch
        {
            // Use default if parsing fails
            imageUrl = Model.ImgUser.Trim('[', ']', '"', ' ');
        }
    }
}

<style>
    /* Copy CSS từ Create.cshtml */
    .user-form-container {
        padding: 1.25rem;
        max-width: 60rem;
        margin: 0 auto;
    }

    .form-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.875rem;
    }

    .form-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .back-btn {
        padding: 0.625rem 1.25rem;
        background-color: #6c757d;
        color: white;
        border: none;
        border-radius: 0.5rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.3s;
    }

        .back-btn:hover {
            background-color: #5a6268;
            color: white;
        }

    .form-card {
        background: white;
        border-radius: 0.75rem;
        padding: 1.875rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
    }

    .form-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.25rem;
        padding-bottom: 0.625rem;
        border-bottom: 0.125rem solid #14a38b;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

    .form-label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 500;
        color: #333;
        font-size: 0.875rem;
    }

    .required {
        color: #dc3545;
    }

    .form-input,
    .form-select,
    .form-textarea {
        width: 100%;
        padding: 0.75rem 0.9375rem;
        border: 0.0625rem solid #ddd;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.3s;
    }

        .form-input:focus,
        .form-select:focus,
        .form-textarea:focus {
            outline: none;
            border-color: #14a38b;
            box-shadow: 0 0 0 0.1875rem rgba(20, 163, 139, 0.1);
        }

    .form-textarea {
        min-height: 6rem;
        resize: vertical;
    }

    .info-note {
        background-color: #e7f3ff;
        border-left: 4px solid #2196f3;
        padding: 1rem;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }

        .info-note p {
            margin: 0;
            color: #0c5689;
            font-size: 0.875rem;
        }

    .form-actions {
        display: flex;
        gap: 0.9375rem;
        justify-content: flex-end;
        padding-top: 1.25rem;
        border-top: 0.0625rem solid #dee2e6;
    }

    .btn {
        padding: 0.75rem 1.875rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s;
    }

    .btn-primary {
        background-color: #14a38b;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0f8570;
        }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .text-danger {
        color: #dc3545;
        font-size: 0.8125rem;
        margin-top: 0.3125rem;
    }

    /* ✅ THÊM CSS cho Avatar Upload */
    .avatar-upload-section {
        text-align: center;
        padding: 1.5rem;
        background: #f8f9fa;
        border-radius: 0.5rem;
        margin-bottom: 1.5rem;
    }

    .avatar-preview-container {
        margin-bottom: 1rem;
    }

    .avatar-preview {
        width: 150px;
        height: 150px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #14a38b;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }

    .avatar-upload-btn {
        display: inline-block;
        padding: 0.625rem 1.25rem;
        background-color: #14a38b;
        color: white;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.3s;
    }

        .avatar-upload-btn:hover {
            background-color: #0f8570;
        }

    .avatar-help-text {
        font-size: 0.8125rem;
        color: #6c757d;
        margin-top: 0.5rem;
    }
</style>

<div class="user-form-container">
    <div class="form-header">
        <h1 class="form-title">Edit User</h1>
        <a href="/admin/user" class="back-btn">
            ← Back to List
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Edit" asp-route-id="@Model.Uid" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Uid" />

            <!-- ✅ Avatar Upload Section -->
            <div class="form-section">
                <h3 class="section-title">User Avatar</h3>
                <div class="avatar-upload-section">
                    <div class="avatar-preview-container">
                        <img id="avatarPreview"
                             src="@imageUrl"
                             alt="Avatar Preview"
                             class="avatar-preview"
                             onerror="this.src='https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png'" />
                    </div>
                    <div class="form-group">
                        <label for="avatarUpload" class="avatar-upload-btn">
                            <i class="fa fa-upload me-2"></i>Change Avatar
                        </label>
                        <input type="file"
                               id="avatarUpload"
                               name="AvatarFile"
                               accept="image/*"
                               class="d-none">
                        <p class="avatar-help-text">
                            Max file size: 5MB. Accepted formats: JPG, PNG, GIF
                        </p>
                    </div>
                </div>
            </div>

            <!-- Personal Information -->
            <div class="form-section">
                <h3 class="section-title">Personal Information</h3>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FullName" class="form-label">
                            Full Name <span class="required">*</span>
                        </label>
                        <input asp-for="FullName" class="form-input" placeholder="Enter full name..." />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">
                            Email <span class="required">*</span>
                        </label>
                        <input asp-for="Email" type="email" class="form-input" placeholder="Enter email..." />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PhoneNumber" class="form-label">
                            Phone Number <span class="required">*</span>
                        </label>
                        <input asp-for="PhoneNumber" class="form-input" placeholder="0901234567" maxlength="10" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="RoleUid" class="form-label">
                            Role <span class="required">*</span>
                        </label>
                        <select asp-for="RoleUid" class="form-select js-example-basic-single">
                            <option value="">-- Select Role --</option>
                            @if (roles != null)
                            {
                                foreach (var role in roles)
                                {
                                    <option value="@role.Uid">@role.RoleName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="RoleUid" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="DateOfBirth" class="form-label">
                            Date of Birth <span class="required">*</span>
                        </label>
                        <input asp-for="DateOfBirth" type="date" class="form-input" id="dateOfBirth" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        <small class="text-muted d-block mt-1" id="ageDisplay"></small>
                    </div>
                </div>

                <div class="form-group full-width">
                    <label asp-for="Address" class="form-label">
                        Address
                    </label>
                    <textarea asp-for="Address" class="form-textarea" placeholder="Enter address..."></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <!-- Change Password (Optional) -->
            <div class="form-section">
                <h3 class="section-title">Change Password (Optional)</h3>

                <div class="info-note">
                    <p><i class="fa-solid fa-info-circle"></i> Leave blank if you don't want to change the password.</p>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="newPassword" class="form-label">
                            New Password
                        </label>
                        <input type="password"
                               id="newPassword"
                               name="newPassword"
                               class="form-input"
                               placeholder="Enter new password..." />
                        <span class="text-danger" id="newPasswordError"></span>
                    </div>

                    <div class="form-group">
                        <label for="confirmPassword" class="form-label">
                            Confirm New Password
                        </label>
                        <input type="password"
                               id="confirmPassword"
                               name="confirmPassword"
                               class="form-input"
                               placeholder="Confirm new password..." />
                        <span class="text-danger" id="confirmPasswordError"></span>
                    </div>
                </div>
            </div>

            <!-- Form Actions -->
            <div class="form-actions">
                <a href="/admin/user" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Update User</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // ✅ Avatar Upload Preview với validation chi tiết
            $('#avatarUpload').on('change', function(e) {
                const file = e.target.files[0];

                console.log('===== AVATAR FILE SELECTED =====');
                console.log('File:', file);

                if (file) {
                    console.log('File name:', file.name);
                    console.log('File size:', file.size, 'bytes');
                    console.log('File type:', file.type);

                    // Validate file size (5MB max)
                    const maxSize = 5 * 1024 * 1024; // 5MB
                    if (file.size > maxSize) {
                        Swal.fire({
                            icon: 'error',
                            title: 'File Too Large',
                            text: `File size is ${(file.size / 1024 / 1024).toFixed(2)}MB. Maximum allowed is 5MB.`
                        });
                        $(this).val(''); // Clear input
                        return;
                    }

                    // Validate file type
                    const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                    if (!allowedTypes.includes(file.type)) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Invalid File Type',
                            text: 'Only JPG, PNG, and GIF images are allowed. Your file type: ' + file.type
                        });
                        $(this).val(''); // Clear input
                        return;
                    }

                    // ✅ Preview image
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        console.log('✅ Image loaded for preview');
                        $('#avatarPreview').attr('src', e.target.result);
                    };
                    reader.onerror = function(e) {
                        console.error('❌ Error reading file:', e);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Failed to read image file'
                        });
                    };
                    reader.readAsDataURL(file);

                    console.log('✅ File validation passed');
                } else {
                    console.log('❌ No file selected');
                }
            });

            // Phone number validation
            $('input[name="PhoneNumber"]').on('input', function() {
                let value = $(this).val();
                value = value.replace(/[^0-9]/g, '');
                if (value.length > 10) {
                    value = value.substring(0, 10);
                }
                $(this).val(value);
            });

            // Password validation
            $('#confirmPassword').on('input', function() {
                const password = $('#newPassword').val();
                const confirmPassword = $(this).val();

                if (password && confirmPassword && password !== confirmPassword) {
                    $('#confirmPasswordError').text('Passwords do not match');
                } else {
                    $('#confirmPasswordError').text('');
                }
            });

            // ✅ QUAN TRỌNG: Validate và log khi submit form
            $('form').on('submit', function(e) {
                console.log('===== FORM SUBMIT TRIGGERED =====');

                const fileInput = document.getElementById('avatarUpload');
                const file = fileInput ? fileInput.files[0] : null;
                const newPassword = $('#newPassword').val();
                const confirmPassword = $('#confirmPassword').val();

                // ✅ Validate password nếu có nhập
                if (newPassword && newPassword.trim() !== '') {
                    if (!confirmPassword || confirmPassword.trim() === '') {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Missing Confirmation',
                            text: 'Please confirm your new password'
                        });
                        console.log('❌ Form submit prevented: Missing password confirmation');
                        return false;
                    }

                    if (newPassword !== confirmPassword) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Password Mismatch',
                            text: 'Password and confirmation password do not match'
                        });
                        console.log('❌ Form submit prevented: Password mismatch');
                        return false;
                    }

                    // Validate password strength
                    const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{6,}$/;
                    if (!passwordRegex.test(newPassword)) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Weak Password',
                            text: 'Password must be at least 6 characters with 1 uppercase, 1 lowercase, 1 number and 1 special character'
                        });
                        console.log('❌ Form submit prevented: Weak password');
                        return false;
                    }
                }

                // ✅ Log form data
                console.log('Form action:', $(this).attr('action'));
                console.log('Form method:', $(this).attr('method'));
                console.log('Form enctype:', $(this).attr('enctype'));

                if (fileInput) {
                    console.log('File input name:', fileInput.name);
                    console.log('File attached:', file ? `${file.name} (${file.size} bytes)` : 'No file');
                }

                if (!file) {
                    console.log('⚠️ WARNING: No avatar file selected, will keep existing avatar');
                } else {
                    console.log('✅ Avatar file will be uploaded:', file.name);
                }

                // ✅ Kiểm tra FormData sẽ được gửi
                const formData = new FormData(this);
                console.log('===== FormData Contents =====');
                for (let pair of formData.entries()) {
                    if (pair[1] instanceof File) {
                        console.log(`  ${pair[0]}: [File] ${pair[1].name} (${pair[1].size} bytes)`);
                    } else {
                        console.log(`  ${pair[0]}: ${pair[1]}`);
                    }
                }

                console.log('✅ Form validation passed - submitting...');
                // Không prevent default - để form submit bình thường
                return true;
            });

            // ✅ Date of Birth age calculator
            $('#dateOfBirth').on('change', function() {
                const dob = new Date($(this).val());
                const today = new Date();
                let age = today.getFullYear() - dob.getFullYear();
                const monthDiff = today.getMonth() - dob.getMonth();

                if (monthDiff < 0 || (monthDiff === 0 && today.getDate() < dob.getDate())) {
                    age--;
                }

                if (age >= 0) {
                    $('#ageDisplay').text(`Age: ${age} years old`);
                } else {
                    $('#ageDisplay').text('');
                }
            });

            // ✅ Trigger age calculation on page load if date exists
            if ($('#dateOfBirth').val()) {
                $('#dateOfBirth').trigger('change');
            }
        });
    </script>
}
