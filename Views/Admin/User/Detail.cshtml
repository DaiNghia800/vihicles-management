@model Public_Transport.Models.Entities.Users
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "User Details";
}

<style>
    .user-detail-container {
        padding: 1.25rem;
        max-width: 60rem;
        margin: 0 auto;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.875rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 0.625rem;
    }

    .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .btn-primary {
        background-color: #14a38b;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0f8570;
        }

    .detail-card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
        overflow: hidden;
    }

    .user-header {
        background: linear-gradient(135deg, #14a38b 0%, #0f8570 100%);
        padding: 2rem;
        text-align: center;
        color: white;
    }

        .user-header .user-avatar {
            width: 8rem;
            height: 8rem;
            border-radius: 50%;
            border: 4px solid white;
            margin-bottom: 1rem;
            object-fit: cover;
        }

        .user-header .user-name {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .user-header .user-email {
            font-size: 1rem;
            opacity: 0.9;
        }

    .user-body {
        padding: 2rem;
    }

    .info-section {
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1.25rem;
        padding-bottom: 0.625rem;
        border-bottom: 0.125rem solid #14a38b;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .info-item {
        display: flex;
        flex-direction: column;
    }

        .info-item .label {
            font-size: 0.8125rem;
            color: #666;
            margin-bottom: 0.375rem;
            font-weight: 500;
        }

        .info-item .value {
            font-size: 1rem;
            color: #333;
            font-weight: 500;
        }

    .role-badge {
        padding: 0.375rem 0.875rem;
        border-radius: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: inline-block;
    }

    .role-admin {
        background-color: #d4edda;
        color: #155724;
    }

    .role-staff {
        background-color: #cfe2ff;
        color: #084298;
    }

    .role-customer {
        background-color: #fff3cd;
        color: #856404;
    }

    .status-badge {
        padding: 0.375rem 0.875rem;
        border-radius: 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        display: inline-block;
    }

    .status-active {
        background-color: #d4edda;
        color: #155724;
    }

    .status-inactive {
        background-color: #f8d7da;
        color: #721c24;
    }
</style>

<div class="user-detail-container">
    <div class="header-section">
        <h1 class="page-title">User Details</h1>
        <div class="header-actions">
            <a href="/admin/user" class="btn btn-secondary">
                ← Back to List
            </a>
            <a href="/admin/user/edit/@Model.Uid" class="btn btn-primary">
                <i class="fa-solid fa-edit"></i> Edit User
            </a>
        </div>
    </div>

    <div class="detail-card">
        <!-- User Header -->
        <div class="user-header">
            <img src="@(string.IsNullOrEmpty(Model.ImgUser) ? "/images/default-avatar.png" : Model.ImgUser)" 
                 alt="@Model.FullName" 
                 class="user-avatar" />
            <div class="user-name">@Model.FullName</div>
            <div class="user-email">@Model.Email</div>
        </div>

        <!-- User Body -->
        <div class="user-body">
            <!-- Personal Information -->
            <div class="info-section">
                <h3 class="section-title">Personal Information</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">Full Name</span>
                        <span class="value">@Model.FullName</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Email</span>
                        <span class="value">@Model.Email</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Phone Number</span>
                        <span class="value">@Model.PhoneNumber</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Address</span>
                        <span class="value">@(string.IsNullOrEmpty(Model.Address) ? "N/A" : Model.Address)</span>
                    </div>
                </div>
            </div>

            <!-- Account Information -->
            <div class="info-section">
                <h3 class="section-title">Account Information</h3>
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">Role</span>
                        <span class="value">
                            <span class="role-badge role-@(Model.Role?.RoleName?.ToLower() ?? "default")">
                                @(Model.Role?.RoleName ?? "N/A")
                            </span>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="label">Status</span>
                        <span class="value">
                            <span class="status-badge status-@(Model.Deleted ? "inactive" : "active")">
                                @(Model.Deleted ? "Inactive" : "Active")
                            </span>
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="label">Created Date</span>
                        <span class="value">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Last Updated</span>
                        <span class="value">@Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Created By</span>
                        <span class="value">@(Model.CreatedBy ?? "N/A")</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Updated By</span>
                        <span class="value">@(Model.UpdatedBy ?? "N/A")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>