@model IEnumerable<Public_Transport.Models.Entities.Route>

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Quản lý Tuyến xe";
}

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 text-primary fw-bold"><i class="fa-solid fa-map-location-dot me-2"></i>Danh sách Tuyến</h5>
        <a asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
            <i class="fa-solid fa-plus me-1"></i> Thêm Tuyến Mới
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger m-3">@TempData["Error"]</div>
    }

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tên Tuyến</th>
                        <th>Mô tả</th>
                        <th>Giá vé</th>
                        <th>Khoảng cách</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold">@item.RouteName</td>
                            <td>@item.Description</td>
                            <td><span class="badge bg-success">@item.BasePrice.ToString("N0") đ</span></td>
                            <td>@item.TotalDistance km</td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.RouteId" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa tuyến này?');" title="Xóa"><i class="fa-solid fa-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>