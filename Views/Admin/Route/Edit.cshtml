@model Public_Transport.Models.Entities.Route

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Cập nhật Tuyến";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Cập nhật Tuyến: @Model.RouteName</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit">
                    <input type="hidden" asp-for="RouteId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="mb-3">
                        <label asp-for="RouteName" class="form-label fw-bold">Tên Tuyến</label>
                        <input asp-for="RouteName" class="form-control" />
                        <span asp-validation-for="RouteName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BasePrice" class="form-label fw-bold">Giá vé (VNĐ)</label>
                            <input asp-for="BasePrice" class="form-control" type="number" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TotalDistance" class="form-label fw-bold">Khoảng cách (km)</label>
                            <input asp-for="TotalDistance" class="form-control" type="number" step="0.1" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 border-top pt-3">
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-warning">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}