@model Public_Transport.Models.Entities.Route

@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Edit Route";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <form asp-action="Edit" id="editRouteForm">
            <input type="hidden" asp-for="RouteId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">1. Edit Route Information</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RouteName" class="form-label fw-bold">Route Name</label>
                            <input asp-for="RouteName" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <input asp-for="Description" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="BasePrice" class="form-label fw-bold">Base Price</label>
                            <input asp-for="BasePrice" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="TotalDistance" class="form-label fw-bold">Total Distance</label>
                            <input asp-for="TotalDistance" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">2. Itinerary (Stations)</h5>
                    <button type="button" class="btn btn-sm btn-light text-dark fw-bold" onclick="addStationRow()">
                        <i class="fa-solid fa-plus"></i> Add Station
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-bordered mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="40%">Station Name</th>
                                    <th width="20%">Distance (km)</th>
                                    <th width="20%">Type</th>
                                    <th width="15%">Action</th>
                                </tr>
                            </thead>
                            <tbody id="stationList">
                                @* Loop render dữ liệu cũ *@
                                @if (Model.RouteDetails != null)
                                {
                                    var detailsList = Model.RouteDetails.OrderBy(x => x.OrderIndex).ToList();

                                    for (int i = 0; i < detailsList.Count; i++)
                                    {
                                        var detail = detailsList[i];
                                        <tr id="row_@i">
                                            <td class="text-center align-middle fw-bold index-cell">@(i + 1)</td>
                                            <td>
                                                <select name="RouteDetails[@i].StationId" class="form-select select2"
                                                        asp-items="@(new SelectList(ViewBag.StationId, "Value", "Text", detail.StationId))">
                                                </select>
                                                <input type="hidden" name="RouteDetails[@i].OrderIndex" value="@(i + 1)" class="order-input" />
                                            </td>
                                            <td>
                                                <input type="number" step="0.1" name="RouteDetails[@i].DistanceFromStart"
                                                       class="form-control" value="@detail.DistanceFromStart" />
                                            </td>
                                            <td>
                                                <div class="form-check form-switch mt-2">
                                                    <input class="form-check-input" type="checkbox" value="true"
                                                           name="RouteDetails[@i].IsMajorStop" id="major_@i"
                                                           @(detail.IsMajorStop ? "checked" : "")>
                                                    <input type="hidden" name="RouteDetails[@i].IsMajorStop" value="false" />
                                                    <label class="form-check-label" for="major_@i">Major Stop</label>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">
                                                <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(@i)">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mb-5">
                <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
                <button type="submit" class="btn btn-warning px-4">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Copy y chang đoạn Script bên Create.cshtml qua đây
        // Vì logic Add/Remove y hệt nhau
        function addStationRow() {
             var index = $('#stationList tr').length;
            var stationOptions = '@Html.Raw(string.Join("", ((SelectList)ViewBag.StationId).Select(s => $"<option value=\"{s.Value}\">{s.Text}</option>")))';

            var rowHtml = `
                <tr id="row_${index}">
                    <td class="text-center align-middle fw-bold index-cell">${index + 1}</td>
                    <td>
                        <select name="RouteDetails[${index}].StationId" class="form-select select2">
                            ${stationOptions}
                        </select>
                        <input type="hidden" name="RouteDetails[${index}].OrderIndex" value="${index + 1}" class="order-input" />
                    </td>
                    <td>
                        <input type="number" step="0.1" name="RouteDetails[${index}].DistanceFromStart" class="form-control" placeholder="0.0" />
                    </td>
                    <td>
                         <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" value="true" name="RouteDetails[${index}].IsMajorStop" id="major_${index}">
                            <input type="hidden" name="RouteDetails[${index}].IsMajorStop" value="false" />
                            <label class="form-check-label" for="major_${index}">Major Stop</label>
                        </div>
                    </td>
                    <td class="text-center align-middle">
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeRow(${index})">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `;

            $('#stationList').append(rowHtml);
            $('.select2').select2({ width: '100%' });
        }

        function removeRow(index) {
            $(`#row_${index}`).remove();
            reIndexRows();
        }

        function reIndexRows() {
            $('#stationList tr').each(function(i, row) {
                $(row).find('.index-cell').text(i + 1);
                $(row).find('select, input').each(function() {
                    var name = $(this).attr('name');
                    if (name) {
                        var newName = name.replace(/RouteDetails\[\d+\]/, `RouteDetails[${i}]`);
                        $(this).attr('name', newName);
                    }
                    if ($(this).hasClass('order-input')) {
                        $(this).val(i + 1);
                    }
                });
            });
        }
    </script>
}