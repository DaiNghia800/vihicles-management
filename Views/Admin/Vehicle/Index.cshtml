@using Public_Transport.Models.Entities;
@using System.Text.Json

@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Vehicle";
}

<section class="product-area">
    <div class="card card-table">
        <div class="header-title">
            <h5>Vehicle List</h5>
            <div class="options">
                <ul>
                    <li>
                        @if (User.HasClaim("permission", "vehicle_create"))
                        {
                            <a href="/admin/vehicle/create" class="btn">Add vehicle</a>
                        }
                    </li>

                </ul>
            </div>
        </div>
        <div class="">
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center me-4">
                        <span class="me-3">Filter</span>
                        <select class="js-example-basic-single" box-filter>
                            <option value="">All</option>
                            <option value="Active">Active</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                     @if (User.HasClaim("permission", "vehicle_edit"))
                     {
                        <div class="d-flex align-items-center">
                            <span class="text-nowrap me-3">Change</span>
                            <form form-change-multi data-patch="/admin/vehicle/change-multi">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <select class="js-example-basic-single" name="status">
                                            <option value="Active">Active</option>
                                            <option value="Inactive">Inactive</option>
                                            <option value="Maintenance">Maintenance</option>
                                            <option value="delete">Delete</option>
                                        </select>
                                    </div>
                                    <div>
                                        <button type="submit">Apply</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                    
                </div>
                <div class="table-search">
                    <label>
                        Search
                        <input type="text" name="name" value="" input-search />
                    </label>
                </div>
            </div>
            <div id="product-list">
                <div class="table-responsive">
                    <table class="table theme-table mb-0">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Image</th>
                                <th>License Plate</th>
                                <th>Vehicle Type</th>
                                <th>Seat Capacity</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (ViewData["Vehicles"] != null)
                                {
                                    foreach (Vehicle vehicle in ViewBag.Vehicles)
                                    {
                                        <tr>
                                            <td>
                                                <input type="checkbox" class="checkbox_animated checkall" input-change="@vehicle.VehicleId" />
                                            </td>
                                            <td>
                                                <div class="table-img">

                                                    @{
                                                        var thumbnails = string.IsNullOrWhiteSpace(vehicle.Thumbnail)
                                                        ? new List<string>()
                                                        : JsonSerializer.Deserialize<List<string>>(vehicle.Thumbnail);

                                                        var firstImg = thumbnails.FirstOrDefault();
                                                    }

                                                    @if (!string.IsNullOrEmpty(firstImg))
                                                    {
                                                        <img src=@firstImg alt="" class="img-fluid" />
                                                    }
                                                </div>
                                            </td>
                                            <td>@vehicle.LicensePlate</td>
                                            <td class="td-category">@vehicle.VehicleType</td>
                                            <td>@vehicle.SeatCapacity</td>
                                            @{
                                                if (vehicle.Status == "Active")
                                                {
                                                    <td class="status status-close">
                                                        <button type="button">@vehicle.Status</button>
                                                    </td>
                                                }
                                                else if(vehicle.Status == "Inactive")
                                                {
                                                    <td class="status status-danger">
                                                        <button type="button">@vehicle.Status</button>
                                                    </td>
                                                } else
                                                {
                                                    <td class="status status-warning">
                                                        <button type="button">@vehicle.Status</button>
                                                    </td>
                                                }

                                            }
                                            <td>
                                                <ul>
                                                    @if (User.HasClaim("permission", "vehicle_edit"))
                                                    {
                                                        <li>
                                                            <a href="/admin/vehicle/edit/@vehicle.VehicleId" class="icon-edit">
                                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.7279 9.57627L14.3137 8.16206L5 17.4758V18.89H6.41421L15.7279 9.57627ZM17.1421 8.16206L18.5563 6.74785L17.1421 5.33363L15.7279 6.74785L17.1421 8.16206ZM7.24264 20.89H3V16.6473L16.435 3.21231C16.8256 2.82179 17.4587 2.82179 17.8492 3.21231L20.6777 6.04074C21.0682 6.43126 21.0682 7.06443 20.6777 7.45495L7.24264 20.89Z"></path></svg>
                                                            </a>
                                                        </li>
                                                    }
                                                    @if (User.HasClaim("permission", "vehicle_delete"))
                                                    {
                                                        <li>
                                                            <a href="#" class="icon-delete" data-patch="/admin/vehicle/delete/@vehicle.VehicleId" button-delete button-id="@vehicle.VehicleId">
                                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"></path></svg>
                                                            </a>
                                                        </li>
                                                    }

                                                </ul>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <nav class="box-page">
                    <ul class="d-flex justify-content-center gap-2">
                        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                            <a href="" button-pagination=@(ViewBag.CurrentPage - 1)>
                                <i class="fa-solid fa-angles-left"></i>
                            </a>
                        </li>
                        @{
                            for (int i = 1; i <= ViewBag.TotalPage; i++)
                            {
                                <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                                    <a href="#" button-pagination=@i>
                                        @i
                                    </a>
                                </li>
                            }
                        }
                        <li class="page-item @(ViewBag.TotalPage == ViewBag.CurrentPage ? "disabled" : "")">
                            <a href="" button-pagination=@(ViewBag.CurrentPage + 1)>
                                <i class="fa-solid fa-angles-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</section>