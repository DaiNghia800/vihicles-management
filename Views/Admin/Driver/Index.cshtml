@model IEnumerable<Public_Transport.Models.Entities.Driver>
@{
    Layout = "_LayoutAdmin";
    ViewData["title"] = "Driver Management";
}

<style>
    .driver-management {
        padding: 1.25rem;
    }

    .header-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.875rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 600;
        color: #333;
        margin: 0;
    }

    .header-actions {
        display: flex;
        gap: 0.9375rem;
    }

    .btn {
        padding: 0.625rem 1.25rem;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        font-size: 0.875rem;
        font-weight: 500;
        transition: all 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-primary {
        background-color: #14a38b;
        color: white;
    }

        .btn-primary:hover {
            background-color: #0f8570;
            transform: translateY(-0.0625rem);
            box-shadow: 0 0.25rem 0.75rem rgba(20, 163, 139, 0.3);
        }

    .table-card {
        background: white;
        border-radius: 0.75rem;
        box-shadow: 0 0.125rem 0.5rem rgba(0,0,0,0.08);
    }

    .driver-table {
        width: 100%;
        border-collapse: collapse;
    }

        .driver-table thead {
            background-color: #f8f9fa;
        }

        .driver-table th {
            padding: 0.9375rem;
            text-align: left;
            font-weight: 600;
            color: #000;
            border-bottom: 0.125rem solid #dee2e6;
            font-size: 0.875rem;
            text-transform: uppercase;
        }

        .driver-table td {
            padding: 0.9375rem;
            border-bottom: 0.0625rem solid #f0f0f0;
            vertical-align: middle;
        }

        .driver-table tbody tr:hover {
            background-color: #f8f9fa;
        }

    .status-badge {
        padding: 0.25rem 0.75rem;
        border-radius: 1rem;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-active {
        background-color: #d4edda;
        color: #155724;
    }

    .status-inactive {
        background-color: #f8d7da;
        color: #721c24;
    }

    .status-suspended {
        background-color: #fff3cd;
        color: #856404;
    }

    .action-icon {
        display: inline-block;
        width: 2.25rem;
        height: 2.25rem;
        padding: 0.5rem;
        border: none;
        border-radius: 50%;
        background-color: transparent;
        cursor: pointer;
        transition: all 0.2s;
    }

        .action-icon svg {
            width: 100%;
            height: 100%;
        }

    .icon-edit {
        color: #4aa4d9;
    }

        .icon-edit:hover {
            background-color: rgba(74, 164, 217, 0.1);
        }

    .icon-delete {
        color: #dc3545;
    }

        .icon-delete:hover {
            background-color: rgba(220, 53, 69, 0.1);
        }
</style>

<div class="driver-management">
    <div class="header-section">
        <h1 class="page-title">Driver Management</h1>
        <div class="header-actions">
            <a href="/admin/driver/license-management" class="btn btn-secondary">
                <i class="fa-solid fa-certificate"></i> License Management
            </a>
            @if (User.HasClaim("permission", "driver_create"))
            {
                <a href="/admin/driver/create" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i> Add New Driver
                </a>
            }
            
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-card">
        <table class="driver-table">
            <thead>
                <tr>
                    <th>Driver Name</th>
                    <th>License Number</th>
                    <th>License Type</th>
                    <th>Expiry Date</th>
                    <th>Experience (Years)</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var driver in Model)
                    {
                        <tr>
                            <td><strong>@driver.User?.FullName</strong></td>
                            <td>@driver.LicenseNumber</td>
                            <td>@driver.LicenseType</td>
                            <td>
                                @if (driver.LicenseExpiry.HasValue)
                                {
                                    var daysUntilExpiry = (driver.LicenseExpiry.Value - DateTime.Now).Days;
                                    <span class="@(daysUntilExpiry < 30 ? "text-danger fw-bold" : "")">
                                        @driver.LicenseExpiry.Value.ToString("dd/MM/yyyy")
                                        @if (daysUntilExpiry >= 0 && daysUntilExpiry < 30)
                                        {
                                            <br /><small>(Expires in @daysUntilExpiry days)</small>
                                        }
                                    </span>
                                }
                                else
                                {
                                    <span>N/A</span>
                                }
                            </td>
                            <td>@driver.ExperienceYears years</td>
                            <td>
                                <span class="status-badge status-@driver.Status?.ToLower()">
                                    @driver.Status
                                </span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @if (User.HasClaim("permission", "driver_edit"))
                                    {
                                        <a href="/admin/driver/edit/@driver.DriverId" class="action-icon icon-edit" title="Edit Driver">
                                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M15.7279 9.57627L14.3137 8.16206L5 17.4758V18.89H6.41421L15.7279 9.57627ZM17.1421 8.16206L18.5563 6.74785L17.1421 5.33363L15.7279 6.74785L17.1421 8.16206ZM7.24264 20.89H3V16.6473L16.435 3.21231C16.8256 2.82179 17.4587 2.82179 17.8492 3.21231L20.6777 6.04074C21.0682 6.43126 21.0682 7.06443 20.6777 7.45495L7.24264 20.89Z"></path></svg>
                                        </a>
                                    }
                                    @if (User.HasClaim("permission", "driver_delete"))
                                    {
                                        <form action="/admin/driver/delete/@driver.DriverId" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this driver?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-icon icon-delete" title="Delete Driver">
                                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4V2H17V4H22V6H20V21C20 21.5523 19.5523 22 19 22H5C4.44772 22 4 21.5523 4 21V6H2V4H7ZM6 6V20H18V6H6ZM9 9H11V17H9V9ZM13 9H15V17H13V9Z"></path></svg>
                                            </button>
                                        </form>
                                    }
                                    
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <p>No drivers found. Add your first driver!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>