        <div class="container mx-auto position-relative z-1 h-100">
            <div class="d-flex justify-content-center align-items-center h-100">
                <div>
                    <h2 class="text-center text-white">Contact</h2>
                    <ul class="d-flex justify-content-center gap-1 list-unstyled">
                        <li><span class="text-white fs-6 fw-light font-secondary">Home</span></li>
                        <li><span class="color-primary text-white mx-2"><i class="fa-solid fa-angle-right"></i></span></li>
                        <li><span class="text-white fs-6 fw-light font-secondary">Contact</span></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

