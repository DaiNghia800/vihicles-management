@model Public_Transport.Models.ViewModels.UserCreateViewModel;
@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Profile Settings";
}

<section class="user-dashboard-section section-b-space">
    <div class="container">
        <form asp-controller="Customer" asp-action="UpdateProfile" asp-route-id="@Model.Uid" method="post" enctype="multipart/form-data" id="mainForm">
            @Html.AntiForgeryToken()
            <div class="row">
                <div class="col-xxl-9 col-lg-8 mx-auto">
                    <div class="dashboard-right-sidebar">
                        <div class="dashboard-home">
                            @if (TempData["SuccessMessage"] != null)
                            {
                                <div class="alert alert-success alert-dismissible fade show" role="alert">
                                    <i class="fa-solid fa-circle-check me-2"></i>
                                    @TempData["SuccessMessage"]
                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                </div>
                            }

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <input type="hidden" asp-for="Uid" />

                            <div class="dashboard-user-name">
                                <div class="row g-3 mt-2">
                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="text" class="form-control" asp-for="FullName" placeholder="Full Name" />
                                            <label asp-for="FullName">Full Name <span class="text-danger">*</span></label>
                                            <span asp-validation-for="FullName" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="email" class="form-control" asp-for="Email" placeholder="Email Address" />
                                            <label asp-for="Email">Email Address <span class="text-danger">*</span></label>
                                            <span asp-validation-for="Email" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="tel" class="form-control" asp-for="PhoneNumber" placeholder="Phone Number" />
                                            <label asp-for="PhoneNumber">Phone Number</label>
                                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="text" class="form-control" asp-for="Address" placeholder="Address" />
                                            <label asp-for="Address">Address</label>
                                            <span asp-validation-for="Address" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="dashboard-user-name mt-4">
                                <h6 class="text-content">Change Password</h6>
                                <p class="text-muted small mb-3">Leave blank if you don't want to change password</p>
                                <div class="row g-3 mt-2">
                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="password" class="form-control" asp-for="Password" placeholder="New Password" />
                                            <label asp-for="Password">New Password</label>
                                            <span asp-validation-for="Password" class="text-danger"></span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating theme-form-floating">
                                            <input type="password" class="form-control" asp-for="ConfirmPassword" placeholder="Confirm Password" />
                                            <label asp-for="ConfirmPassword">Confirm Password</label>
                                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="dashboard-user-name mt-4">
                                <h6 class="text-content">Profile Picture</h6>
                                <div class="mt-3">
                                    <div id="my-dropzone" class="dropzone" style="z-index:0; min-height: 200px;"></div>
                                    <input type="hidden" name="ImgUser" id="Thumbnail"
                                           data-thumbnail='@(string.IsNullOrEmpty(Model.ImgUser) ? "[\"https://res.cloudinary.com/dfeaar87r/image/upload/v1763101391/default-avatar_uek2f1.png\"]" : Model.ImgUser)' />
                                </div>
                            </div>

                            <div class="dashboard-user-name mt-4">
                                <h6 class="text-content">Account Role</h6>
                                <div class="col-12 mt-2">
                                    <select asp-for="RoleUid" class="form-select" disabled>
                                        <option value="">-- Choose one Role --</option>
                                        @if (ViewData["RolesList"] != null)
                                        {
                                            @foreach (var item in (ViewData["RolesList"] as SelectList))
                                            {
                                                <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                                            }
                                        }
                                    </select>
                                    <input type="hidden" asp-for="RoleUid" />
                                    <small class="text-muted d-block mt-2">
                                        <i class="fa-solid fa-info-circle"></i> You cannot change your account role
                                    </small>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                                <a href="/" class="btn btn-secondary btn-animation">
                                    <i class="fa-solid fa-arrow-left me-2"></i>
                                    Back to Home
                                </a>
                                <button type="submit" class="btn btn-animation btn-process mt-0 text-light" button-save>
                                    <i class="fa-solid fa-save me-2"></i>
                                    Update Profile
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password validation
        $(document).ready(function () {
            $('input[name="Password"], input[name="ConfirmPassword"]').on('input', function () {
                const password = $('input[name="Password"]').val();
                const confirmPassword = $('input[name="ConfirmPassword"]').val();

                if (password && confirmPassword && password !== confirmPassword) {
                    $('input[name="ConfirmPassword"]').addClass('is-invalid');
                } else {
                    $('input[name="ConfirmPassword"]').removeClass('is-invalid');
                }
            });
        });
    </script>
}